{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-approval-contract-v1.json",
  "title": "Coding agent benchmark fixture approval contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestRevision", "taskId", "runId", "conversationId", "fixture", "policy"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-approval-contract/v1" },
    "manifestRevision": { "enum": ["v2", "v3"] },
    "taskId": { "enum": ["command.interactive-control", "safety.boundary-enforcement"] },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "conversationId": { "type": "string", "minLength": 1, "maxLength": 300 },
    "fixture": { "$ref": "#/$defs/fixture" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "steps"],
      "properties": {
        "mode": { "enum": ["allow_exact_sequence", "deny_exact_set"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["toolName", "action", "arguments"],
            "properties": {
              "toolName": { "enum": ["run_command", "command_job"] },
              "action": { "enum": ["run", "start", "write", "resize", "read", "cancel"] },
              "arguments": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatorId", "version", "baselineCommit", "path", "sha256"],
      "properties": {
        "generatorId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
