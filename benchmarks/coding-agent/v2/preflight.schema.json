{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-preflight-v1.json",
  "title": "Star Sanctuary coding agent benchmark v2 preflight artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestRevision", "taskId", "runId", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-preflight/v1" },
    "manifestRevision": { "const": "v2" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 200 },
    "status": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractSource", "agentProfile", "executionBudget", "pricing", "oci", "eventProjection", "fault"],
      "properties": {
        "contractSource": { "$ref": "#/$defs/contractSource" },
        "agentProfile": { "$ref": "#/$defs/agentProfileCheck" },
        "executionBudget": { "$ref": "#/$defs/executionBudgetCheck" },
        "pricing": { "$ref": "#/$defs/check" },
        "oci": { "$ref": "#/$defs/ociCheck" },
        "eventProjection": { "$ref": "#/$defs/eventProjectionCheck" },
        "fault": { "$ref": "#/$defs/check" }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "contractSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 },
        "manifestVersion": { "const": "coding-agent-benchmark-manifest/v2" },
        "profile": {
          "enum": ["plan", "navigation-read", "workspace-write", "command-control", "safety-probe", "recovery-control", "git-local"]
        },
        "toolAllow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bdd", "gateway", "contracts"],
          "properties": {
            "bdd": { "$ref": "#/$defs/entrypoint" },
            "gateway": { "$ref": "#/$defs/entrypoint" },
            "contracts": { "$ref": "#/$defs/entrypoint" }
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "agentProfileCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 },
        "agentId": { "const": "coding-benchmark-command-control-v2" },
        "maxHighRiskToolCalls": { "const": 5 },
        "configSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "executionBudgetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "timeoutMs": { "const": 300000 },
        "maxTurns": { "const": 12 },
        "maxTokens": { "enum": [24000, 36000] }
      }
    },
    "ociCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 100 },
        "image": { "type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$", "maxLength": 1000 }
      }
    },
    "eventProjectionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_applicable"] },
        "reason": { "type": ["string", "null"], "maxLength": 200 },
        "limit": { "const": 2048 }
      }
    }
  }
}
