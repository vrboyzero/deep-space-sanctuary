{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-run-v1.json",
  "title": "Star Sanctuary coding agent benchmark run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "attempt",
    "platform",
    "fixture",
    "status",
    "failureCategory",
    "execution",
    "environment",
    "evaluation",
    "usage",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-run/v1" },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 200
    },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "platform": { "enum": ["windows-native", "wsl2-linux"] },
    "fixture": { "$ref": "#/$defs/fixture" },
    "status": { "enum": ["passed", "failed", "blocked", "infrastructure_error"] },
    "failureCategory": {
      "type": ["string", "null"],
      "enum": [
        "model",
        "tool",
        "permission",
        "platform",
        "product_workflow",
        "infrastructure",
        "fixture",
        "evaluator",
        null
      ]
    },
    "execution": { "$ref": "#/$defs/execution" },
    "environment": { "$ref": "#/$defs/environment" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "usage": { "$ref": "#/$defs/usage" },
    "artifacts": { "$ref": "#/$defs/artifacts" }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatorId", "version", "resetStrategy", "baselineCommit"],
      "properties": {
        "generatorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-v1$",
          "maxLength": 100
        },
        "version": { "const": 1 },
        "resetStrategy": { "const": "regenerate" },
        "baselineCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "budgets", "infrastructureRetries"],
      "properties": {
        "profile": {
          "enum": [
            "plan",
            "workspace-write",
            "command-control",
            "safety-probe",
            "recovery-control",
            "git-local"
          ]
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutMs", "maxTurns", "maxTokens"],
          "properties": {
            "timeoutMs": { "type": "integer", "const": 300000 },
            "maxTurns": { "type": "integer", "const": 12 },
            "maxTokens": { "type": "integer", "const": 24000 }
          }
        },
        "infrastructureRetries": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osRelease", "arch", "nodeVersion", "packageManager", "wsl", "model"],
      "properties": {
        "osRelease": { "type": "string", "minLength": 1, "maxLength": 300 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 50 },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "packageManager": { "type": "string", "minLength": 1, "maxLength": 100 },
        "wsl": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["distribution", "version"],
              "properties": {
                "distribution": { "type": "string", "minLength": 1, "maxLength": 100 },
                "version": { "type": "integer", "const": 2 }
              }
            }
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "credentialsConfigured"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "credentialsConfigured": { "type": "boolean" }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "taskCompleted",
        "testsPassed",
        "patchAccepted",
        "regressionCount",
        "manualInterventionCount",
        "dangerousOperationBlocked",
        "recoverySucceeded"
      ],
      "properties": {
        "source": { "const": "machine" },
        "taskCompleted": { "type": "boolean" },
        "testsPassed": { "type": ["boolean", "null"] },
        "patchAccepted": { "type": ["boolean", "null"] },
        "regressionCount": { "type": "integer", "minimum": 0 },
        "manualInterventionCount": { "type": "integer", "minimum": 0 },
        "dangerousOperationBlocked": { "type": ["boolean", "null"] },
        "recoverySucceeded": { "type": ["boolean", "null"] }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "inputTokens", "outputTokens"],
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "events", "result", "patch", "diagnostics", "status"],
      "properties": {
        "manifest": { "$ref": "#/$defs/artifactPath" },
        "events": { "$ref": "#/$defs/artifactPath" },
        "result": { "$ref": "#/$defs/artifactPath" },
        "patch": { "$ref": "#/$defs/artifactPath" },
        "diagnostics": { "$ref": "#/$defs/artifactPath" },
        "status": { "$ref": "#/$defs/artifactPath" },
        "faultInjection": { "$ref": "#/$defs/artifactPath" },
        "cancelInjection": { "$ref": "#/$defs/artifactPath" },
        "restartInjection": { "$ref": "#/$defs/artifactPath" }
      }
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
