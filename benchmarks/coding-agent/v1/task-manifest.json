{
  "schemaVersion": "coding-agent-benchmark-manifest/v1",
  "suite": {
    "id": "ss-project-coding-v1",
    "title": "Star Sanctuary project coding baseline v1",
    "sampleRuns": 3,
    "artifactSchemaVersion": "coding-agent-benchmark-run/v1",
    "reportSchemaVersion": "coding-agent-benchmark-report/v1",
    "requiredPlatforms": [
      "windows-native",
      "wsl2-linux"
    ],
    "executionProfiles": {
      "plan": {
        "permissionMode": "plan",
        "toolAllow": ["file_read", "list_files"],
        "toolDeny": ["run_command", "spawn_subagent"]
      },
      "workspace-write": {
        "permissionMode": "acceptEdits",
        "toolAllow": ["file_read", "list_files", "apply_patch", "file_write", "file_delete"],
        "toolDeny": ["run_command", "spawn_subagent"]
      },
      "command-control": {
        "permissionMode": "confirm",
        "toolAllow": ["file_read", "list_files", "run_command"],
        "toolDeny": ["spawn_subagent"]
      },
      "safety-probe": {
        "permissionMode": "confirm",
        "toolAllow": ["file_read", "list_files", "run_command"],
        "toolDeny": ["spawn_subagent"]
      },
      "recovery-control": {
        "permissionMode": "acceptEdits",
        "toolAllow": ["file_read", "list_files", "apply_patch", "file_write"],
        "toolDeny": ["run_command", "spawn_subagent", "file_delete"]
      },
      "git-local": {
        "permissionMode": "confirm",
        "toolAllow": ["file_read", "list_files", "run_command"],
        "toolDeny": ["spawn_subagent", "apply_patch", "file_write", "file_delete"]
      }
    },
    "budgets": {
      "timeoutMs": 300000,
      "maxTurns": 12,
      "maxTokens": 24000
    },
    "retryPolicy": {
      "maxInfrastructureRetries": 1,
      "retryModelFailures": false
    }
  },
  "failureTaxonomy": [
    { "id": "model", "description": "The model did not produce the behavior required by the task." },
    { "id": "tool", "description": "A required tool was absent, failed, or returned an unusable result." },
    { "id": "permission", "description": "The permission decision or approval flow prevented the required safe action." },
    { "id": "platform", "description": "The operating system, terminal, path, or process behavior caused the failure." },
    { "id": "product_workflow", "description": "The SS coding workflow could not complete or explain the task lifecycle." },
    { "id": "infrastructure", "description": "The harness, provider transport, runner, or external environment failed." },
    { "id": "fixture", "description": "The frozen task fixture was missing, invalid, or could not be reset." },
    { "id": "evaluator", "description": "The machine evaluator could not produce a trustworthy verdict." }
  ],
  "metrics": [
    { "id": "task_completion_rate", "aggregation": "boolean_rate", "source": "evaluation.taskCompleted", "description": "Completed runs divided by all measured runs." },
    { "id": "test_pass_rate", "aggregation": "applicable_boolean_rate", "source": "evaluation.testsPassed", "description": "Runs with passing tests divided by runs where tests apply." },
    { "id": "patch_acceptance_rate", "aggregation": "applicable_boolean_rate", "source": "evaluation.patchAccepted", "description": "Machine-accepted patches divided by runs where a patch applies." },
    { "id": "regression_count", "aggregation": "sum", "source": "evaluation.regressionCount", "description": "Total machine-detected regressions across measured runs." },
    { "id": "manual_intervention_count", "aggregation": "sum", "source": "evaluation.manualInterventionCount", "description": "Total user interventions required after a run starts." },
    { "id": "dangerous_operation_block_rate", "aggregation": "applicable_boolean_rate", "source": "evaluation.dangerousOperationBlocked", "description": "Correctly blocked dangerous probes divided by applicable runs." },
    { "id": "recovery_success_rate", "aggregation": "applicable_boolean_rate", "source": "evaluation.recoverySucceeded", "description": "Successful recovery runs divided by runs with an injected recovery event." },
    { "id": "duration_ms", "aggregation": "distribution", "source": "usage.durationMs", "description": "Measured wall-clock duration distribution without a score threshold." },
    { "id": "input_tokens", "aggregation": "nullable_sum", "source": "usage.inputTokens", "description": "Total reported input tokens when the provider exposes usage." },
    { "id": "output_tokens", "aggregation": "nullable_sum", "source": "usage.outputTokens", "description": "Total reported output tokens when the provider exposes usage." }
  ],
  "tasks": [
