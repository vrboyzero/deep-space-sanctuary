{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-navigation-shadow-v2-analysis-v1.json",
  "title": "Coding Agent Benchmark Navigation Shadow v2 Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "taskId",
    "candidateId",
    "model",
    "decision",
    "execution",
    "baseline",
    "offlineCandidate",
    "platforms",
    "crossPlatform",
    "attribution",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-navigation-shadow-v2-analysis/v1" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "status": { "const": "completed" },
    "taskId": { "const": "real-js.bug-fix" },
    "candidateId": { "const": "workspace-write-navigation-candidate-v2" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "const": "deepseek" },
        "id": { "const": "deepseek-v4-flash" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasonCodes",
        "technicalDebtDecision",
        "nextCandidate",
        "requiresNewProviderAuthorization"
      ],
      "properties": {
        "status": { "const": "do_not_promote" },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cross_platform_product_failure",
              "prompt_contract_not_cross_platform_stable",
              "runtime_tool_argument_contract_drift",
              "token_outcome_not_cross_platform_stable",
              "edit_phase_not_reached",
              "machine_evaluator_failed"
            ]
          }
        },
        "technicalDebtDecision": { "const": "split_task" },
        "nextCandidate": { "const": "navigation-candidate-v3-runtime-contract-required" },
        "requiresNewProviderAuthorization": { "const": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "modelCalls",
        "providerCostUsd",
        "networkCalls",
        "hostCommandToolCalls",
        "manifestModified",
        "v3AggregateModified"
      ],
      "properties": {
        "mode": { "const": "offline-analysis" },
        "modelCalls": { "const": 0 },
        "providerCostUsd": { "const": 0 },
        "networkCalls": { "const": 0 },
        "hostCommandToolCalls": { "const": 0 },
        "manifestModified": { "const": false },
        "v3AggregateModified": { "const": false }
      }
    },
    "baseline": { "$ref": "#/$defs/baseline" },
    "offlineCandidate": { "$ref": "#/$defs/offlineCandidate" },
    "platforms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/platform" },
            { "properties": { "platform": { "const": "windows-native" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/platform" },
            { "properties": { "platform": { "const": "wsl2-linux" } } }
          ]
        }
      ],
      "items": false
    },
    "crossPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameManifestSha256",
        "sameBaselineCommit",
        "sameRepositorySnapshotIdentity",
        "providerModelMatched",
        "sharedFailureSignature",
        "providerUsageComplete",
        "preflightsPassed",
        "promptContractStable",
        "tokenOutcomeStable",
        "totalObservedCostCny"
      ],
      "properties": {
        "sameManifestSha256": { "const": true },
        "sameBaselineCommit": { "const": true },
        "sameRepositorySnapshotIdentity": { "const": true },
        "providerModelMatched": { "const": true },
        "sharedFailureSignature": { "const": true },
        "providerUsageComplete": { "const": true },
        "preflightsPassed": { "const": true },
        "promptContractStable": { "const": false },
        "tokenOutcomeStable": { "const": false },
        "totalObservedCostCny": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "contributors", "excluded"],
      "properties": {
        "primary": { "const": "prompt_only_navigation_contract_not_runtime_stable" },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostics": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonNegative": { "type": "number", "minimum": 0 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "modelCalls",
        "toolCallCount",
        "changedFileCount",
        "budgetExhausted",
        "modelVisibleResponseBytes"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "toolCallCount": { "type": "integer", "minimum": 0 },
        "changedFileCount": { "const": 0 },
        "budgetExhausted": { "const": true },
        "modelVisibleResponseBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "offlineCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallCount", "modelVisibleResponseBytes", "tokenImpactStatus"],
      "properties": {
        "toolCallCount": { "type": "integer", "minimum": 1 },
        "modelVisibleResponseBytes": { "type": "integer", "minimum": 1 },
        "tokenImpactStatus": { "const": "not_measured" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "runId",
        "outcome",
        "usage",
        "budget",
        "promptContract",
        "tools",
        "execution",
        "evaluator",
        "comparison",
        "source"
      ],
      "properties": {
        "platform": { "enum": ["windows-native", "wsl2-linux"] },
        "runId": { "type": "string", "minLength": 1 },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failureCategory"],
          "properties": {
            "status": { "const": "failed" },
            "failureCategory": { "const": "product_workflow" }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "complete",
            "inputTokens",
            "outputTokens",
            "totalTokens",
            "modelCalls",
            "costUsd",
            "costCny"
          ],
          "properties": {
            "source": { "const": "provider_reported" },
            "complete": { "const": true },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "totalTokens": { "type": "integer", "minimum": 1 },
            "modelCalls": { "type": "integer", "minimum": 1 },
            "costUsd": { "$ref": "#/$defs/nonNegative" },
            "costCny": { "$ref": "#/$defs/nonNegative" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "limit", "observed"],
          "properties": {
            "kind": { "const": "total_tokens" },
            "limit": { "const": 24000 },
            "observed": { "type": "integer", "minimum": 24001 }
          }
        },
        "promptContract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategyId",
            "enforcement",
            "runtimeToolGuard",
            "compliant",
            "fileGlobBeforeSourceRead",
            "regressionTestReadBeforeSourceInspection",
            "boundedTextSearchObserved",
            "fullTargetReadBeforeLocalization",
            "repeatedCompleteFileReadCount"
          ],
          "properties": {
            "strategyId": { "const": "bounded-localize-before-read/v1" },
            "enforcement": { "const": "prompt_contract" },
            "runtimeToolGuard": { "const": false },
            "compliant": { "type": "boolean" },
            "fileGlobBeforeSourceRead": { "type": "boolean" },
            "regressionTestReadBeforeSourceInspection": { "type": "boolean" },
            "boundedTextSearchObserved": { "type": "boolean" },
            "fullTargetReadBeforeLocalization": { "type": "boolean" },
            "repeatedCompleteFileReadCount": { "type": "integer", "minimum": 0 }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "callCount",
            "successfulCount",
            "failedCount",
            "invalidGlobArgumentFailureCount",
            "broadGlobReturnedCount",
            "sequence",
            "modelVisibleResponseBytes",
            "editCallCount"
          ],
          "properties": {
            "callCount": { "type": "integer", "minimum": 1 },
            "successfulCount": { "type": "integer", "minimum": 1 },
            "failedCount": { "type": "integer", "minimum": 0 },
            "invalidGlobArgumentFailureCount": { "type": "integer", "minimum": 0 },
            "broadGlobReturnedCount": { "type": "integer", "minimum": 0 },
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "file_read",
                  "list_files",
                  "text_search",
                  "file_glob",
                  "file_edit",
                  "apply_patch",
                  "file_write",
                  "file_delete"
                ]
              }
            },
            "modelVisibleResponseBytes": { "type": "integer", "minimum": 1 },
            "editCallCount": { "const": 0 }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enteredEditPhase",
            "budgetExhausted",
            "changedFileCount",
            "preflightsPassed"
          ],
          "properties": {
            "enteredEditPhase": { "const": false },
            "budgetExhausted": { "const": true },
            "changedFileCount": { "const": 0 },
            "preflightsPassed": { "const": true }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "taskCompleted",
            "testsPassed",
            "patchAccepted",
            "regressionCount",
            "manualInterventionCount"
          ],
          "properties": {
            "source": { "const": "machine" },
            "taskCompleted": { "const": false },
            "testsPassed": { "const": false },
            "patchAccepted": { "const": false },
            "regressionCount": { "type": "integer", "minimum": 1 },
            "manualInterventionCount": { "type": "integer", "minimum": 0 }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vsBaselineTotalTokenDelta",
            "vsCandidateV1TotalTokenDelta",
            "vsCandidateV1ModelCallDelta",
            "vsCandidateV1ToolCallDelta",
            "actualVsOfflineResponseBytesDelta",
            "budgetOverflowTokens"
          ],
          "properties": {
            "vsBaselineTotalTokenDelta": { "type": "integer" },
            "vsCandidateV1TotalTokenDelta": { "type": "integer", "maximum": -1 },
            "vsCandidateV1ModelCallDelta": { "type": "integer" },
            "vsCandidateV1ToolCallDelta": { "type": "integer" },
            "actualVsOfflineResponseBytesDelta": { "type": "integer", "minimum": 1 },
            "budgetOverflowTokens": { "type": "integer", "minimum": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shadowArtifactSha256",
            "candidateEvidenceSha256",
            "v1AnalysisSha256",
            "eventsSha256",
            "executionReportSha256",
            "manifestSha256",
            "baselineCommit",
            "repositorySnapshotIdentitySha256"
          ],
          "properties": {
            "shadowArtifactSha256": { "$ref": "#/$defs/sha256" },
            "candidateEvidenceSha256": { "$ref": "#/$defs/sha256" },
            "v1AnalysisSha256": { "$ref": "#/$defs/sha256" },
            "eventsSha256": { "$ref": "#/$defs/sha256" },
            "executionReportSha256": { "$ref": "#/$defs/sha256" },
            "manifestSha256": { "$ref": "#/$defs/sha256" },
            "baselineCommit": { "$ref": "#/$defs/sha1" },
            "repositorySnapshotIdentitySha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  }
}
