{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "identity",
    "workspaceRoot",
    "windowsHarnessRoot",
    "wsl",
    "roots",
    "repositoryConfigs",
    "contracts",
    "costBaseline",
    "selection",
    "providerEnvPath",
    "execution"
  ],
  "properties": {
    "schemaVersion": {
      "const": "coding-agent-candidate-runner-config/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "mode": {
      "enum": [
        "formal",
        "exploration"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "workspaceDirty",
        "lockfileSha256",
        "worktreeContentSha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workspaceDirty": {
          "const": false
        },
        "lockfileSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worktreeContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "windowsHarnessRoot": {
      "type": "string",
      "minLength": 1
    },
    "wsl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "harnessRoot",
        "toolchainBin",
        "chromePath",
        "libraryPath"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "harnessRoot": {
          "type": "string",
          "minLength": 1
        },
        "toolchainBin": {
          "type": "string",
          "minLength": 1
        },
        "chromePath": {
          "type": "string",
          "minLength": 1
        },
        "libraryPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "fixtures",
        "state",
        "ledger"
      ],
      "properties": {
        "artifacts": {
          "type": "string",
          "minLength": 1
        },
        "fixtures": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "ledger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repositoryConfigs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows-native",
        "wsl2-linux"
      ],
      "properties": {
        "windows-native": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "wsl2-linux": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "scorecard",
        "mapping",
        "agents",
        "expectedReportPlan"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scorecard": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mapping": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "agents": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedReportPlan": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "costBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 144,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "platform",
          "attempt"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "platform": {
            "enum": [
              "windows-native",
              "wsl2-linux"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "providerEnvPath": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId",
        "port",
        "singleRunMaxUsd",
        "runnerMaxUsd",
        "authorizedMaxRmb",
        "usdToRmb",
        "maxTurns",
        "maxTokens",
        "providerRetries",
        "inputUsdPerMillion",
        "outputUsdPerMillion",
        "cacheReadUsdPerMillion",
        "ociImage"
      ],
      "properties": {
        "provider": {
          "const": "openai"
        },
        "modelId": {
          "const": "deepseek-v4-flash"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "singleRunMaxUsd": {
          "const": 0.1
        },
        "runnerMaxUsd": {
          "const": 5
        },
        "authorizedMaxRmb": {
          "const": 80
        },
        "usdToRmb": {
          "const": 8
        },
        "maxTurns": {
          "const": 12
        },
        "maxTokens": {
          "const": 24000
        },
        "taskTokenCaps": {
          "const": {
            "command.interactive-control": 36000,
            "safety.boundary-enforcement": 32000,
            "real-go.public-api-migration": 64000
          }
        },
        "providerRetries": {
          "const": 0
        },
        "inputUsdPerMillion": {
          "const": 0.125
        },
        "outputUsdPerMillion": {
          "const": 0.25
        },
        "cacheReadUsdPerMillion": {
          "const": 0.0025
        },
        "ociImage": {
          "const": "node:22-bullseye@sha256:62f550497561d6285e10abd952730db89c905be990237eaf8744137929c72844"
        }
      }
    }
  }
}
