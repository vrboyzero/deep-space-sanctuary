{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-expected-report-plan-v1.json",
  "title": "Star Sanctuary coding agent benchmark expected report plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestSha256", "reports"],
  "allOf": [
    {
      "if": { "required": ["candidate"] },
      "then": {
        "properties": {
          "reports": {
            "minItems": 144,
            "maxItems": 144,
            "items": { "required": ["reportId", "taskId", "platform", "attempt", "path"] }
          }
        }
      },
      "else": {
        "properties": {
          "reports": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["taskId"] },
                  { "required": ["platform"] },
                  { "required": ["attempt"] }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-expected-report-plan/v1" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reportId", "path"],
        "properties": {
          "reportId": { "$ref": "#/$defs/reportId" },
          "taskId": { "$ref": "#/$defs/reportId" },
          "platform": { "enum": ["windows-native", "wsl2-linux"] },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "workspaceDirty", "lockfileSha256", "worktreeContentSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "workspaceDirty": { "const": false },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "worktreeContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "harness"],
      "properties": {
        "id": { "$ref": "#/$defs/reportId" },
        "source": { "$ref": "#/$defs/source" },
        "harness": { "$ref": "#/$defs/source" }
      }
    },
    "reportId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
