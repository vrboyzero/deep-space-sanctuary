{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-candidate-global-runner-input-v1.json",
  "title": "Star Sanctuary coding agent benchmark candidate-global runner input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "aggregateRoot",
    "generatedAt",
    "sensitiveRoots",
    "sensitiveValueEnvironmentVariables",
    "resourceInventories",
    "wslDistribution"
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-candidate-global-runner-input/v1" },
    "aggregateRoot": { "$ref": "#/$defs/nonEmptyString" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scorecardPath": { "$ref": "#/$defs/nonEmptyString" },
    "sensitiveRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "sensitiveValueEnvironmentVariables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 128
      }
    },
    "resourceInventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-native", "wsl2-linux"],
      "properties": {
        "windows-native": { "$ref": "#/$defs/resourceInventory" },
        "wsl2-linux": { "$ref": "#/$defs/resourceInventory" }
      }
    },
    "wslDistribution": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "resourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listeners", "processIds", "runtimeMarkers", "runtimeEnvFiles"],
      "properties": {
        "listeners": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "port"],
            "properties": {
              "host": { "type": "string", "minLength": 1, "maxLength": 64 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "processIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        },
        "runtimeMarkers": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "runtimeEnvFiles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
