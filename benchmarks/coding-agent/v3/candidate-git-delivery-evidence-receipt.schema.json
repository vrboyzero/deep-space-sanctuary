{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-candidate-git-delivery-evidence-receipt-v1.json",
  "title": "Star Sanctuary coding agent benchmark candidate Git delivery evidence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "aggregate", "sourceIdentity", "worktreeSoak", "reviewRemediation", "remoteAuthority", "recoveryAudit", "summary"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-candidate-git-delivery-evidence-receipt/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "aggregate": { "type": "object" },
    "sourceIdentity": { "$ref": "#/$defs/sourceIdentity" },
    "worktreeSoak": { "$ref": "#/$defs/artifactReference" },
    "reviewRemediation": { "$ref": "#/$defs/artifactReference" },
    "remoteAuthority": { "$ref": "#/$defs/artifactReference" },
    "recoveryAudit": { "$ref": "#/$defs/artifactReference" },
    "summary": { "type": "object", "additionalProperties": false, "required": ["multiRepositoryWorktreeSoak", "reviewRemediationLoop", "remoteDeliveryAuthoritySeparation", "deliveryRecoveryAuditMatrix"], "properties": { "multiRepositoryWorktreeSoak": { "type": "boolean" }, "reviewRemediationLoop": { "type": "boolean" }, "remoteDeliveryAuthoritySeparation": { "type": "boolean" }, "deliveryRecoveryAuditMatrix": { "type": "boolean" } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "sourceIdentity": { "type": "object", "additionalProperties": false, "required": ["harness", "files", "aggregateSha256"], "properties": { "harness": { "type": "object" }, "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } } }, "aggregateSha256": { "$ref": "#/$defs/sha256" } } }
  }
}
