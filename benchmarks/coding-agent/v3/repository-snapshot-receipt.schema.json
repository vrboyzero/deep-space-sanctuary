{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-snapshot-receipt-v1.json",
  "title": "Star Sanctuary coding agent benchmark repository snapshot receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "source",
    "license",
    "dependencyCache",
    "policy",
    "preparedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-snapshot-receipt/v1" },
    "repositoryId": { "enum": ["express", "preact", "spf13-cobra", "vscode-languageserver-node"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit", "workspaceDirty", "worktreeContentSha256", "dependencyInputsSha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$", "maxLength": 300 },
        "commit": { "$ref": "#/$defs/commit" },
        "workspaceDirty": { "const": false },
        "worktreeContentSha256": { "$ref": "#/$defs/sha256" },
        "dependencyInputsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "path", "sha256"],
      "properties": {
        "spdx": { "enum": ["MIT", "Apache-2.0"] },
        "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$", "maxLength": 300 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cacheKey", "contentSha256"],
      "properties": {
        "cacheKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$" },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparationNetwork", "executionNetwork", "dependencyPolicy"],
      "properties": {
        "preparationNetwork": { "const": "allowlisted-source-only" },
        "executionNetwork": { "const": "disabled" },
        "dependencyPolicy": { "const": "pinned-cache-required" }
      }
    },
    "preparedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
