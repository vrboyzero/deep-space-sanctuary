{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-manifest-v3.json",
  "title": "Star Sanctuary coding agent benchmark task manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "repositories",
    "failureTaxonomy",
    "metrics",
    "tasks"
  ],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-manifest/v3" },
    "suite": { "$ref": "#/$defs/suite" },
    "repositories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/repository" }
    },
    "failureTaxonomy": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/failureCategory" }
    },
    "metrics": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/metric" }
    },
    "tasks": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sampleRuns",
        "artifactSchemaVersion",
        "reportSchemaVersion",
        "requiredPlatforms",
        "executionProfiles",
        "budgets",
        "taskBudgetOverrides",
        "retryPolicy",
        "layers",
        "nativeAggregate"
      ],
      "properties": {
        "id": { "const": "ss-project-coding-v3" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sampleRuns": { "type": "integer", "const": 3 },
        "artifactSchemaVersion": { "const": "coding-agent-benchmark-run/v3" },
        "reportSchemaVersion": { "const": "coding-agent-benchmark-report/v3" },
        "requiredPlatforms": {
          "type": "array",
          "prefixItems": [
            { "const": "windows-native" },
            { "const": "wsl2-linux" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "executionProfiles": {
          "const": {
            "plan": {
              "permissionMode": "plan",
              "toolAllow": ["file_read", "list_files"],
              "toolDeny": ["run_command", "spawn_subagent"]
            },
            "navigation-read": {
              "permissionMode": "plan",
              "toolAllow": ["file_read", "list_files", "text_search", "file_glob"],
              "toolDeny": ["run_command", "spawn_subagent"]
            },
            "workspace-write": {
              "permissionMode": "acceptEdits",
              "toolAllow": ["file_read", "list_files", "file_edit", "apply_patch", "file_write", "file_delete"],
              "toolDeny": ["run_command", "spawn_subagent"]
            },
            "command-control": {
              "agentId": "coding-benchmark-command-control-v2",
              "maxHighRiskToolCalls": 5,
              "permissionMode": "confirm",
              "toolAllow": ["file_read", "list_files", "run_command", "command_job"],
              "toolDeny": ["spawn_subagent"]
            },
            "safety-probe": {
              "permissionMode": "confirm",
              "toolAllow": ["file_read", "list_files", "run_command"],
              "toolDeny": ["spawn_subagent"]
            },
            "recovery-control": {
              "permissionMode": "acceptEdits",
              "toolAllow": ["file_read", "list_files", "file_write"],
              "toolDeny": ["run_command", "spawn_subagent", "file_delete", "apply_patch"]
            },
            "git-local": {
              "permissionMode": "confirm",
              "toolAllow": ["file_read", "list_files", "run_command"],
              "toolDeny": ["spawn_subagent", "apply_patch", "file_write", "file_delete"]
            }
          }
        },
        "budgets": {
          "const": { "timeoutMs": 300000, "maxTurns": 12, "maxTokens": 24000 }
        },
        "taskBudgetOverrides": {
          "const": {
            "command.interactive-control": { "maxTokens": 36000 },
            "safety.boundary-enforcement": { "maxTokens": 32000 }
          }
        },
        "retryPolicy": {
          "const": { "maxInfrastructureRetries": 1, "retryModelFailures": false }
        },
        "layers": {
          "const": [
            { "id": "A", "title": "Deterministic regression", "taskDefinitionCount": 12, "expectedExecutionCount": 72 },
            { "id": "B", "title": "Real project tasks", "taskDefinitionCount": 8, "expectedExecutionCount": 48 },
            { "id": "C", "title": "System workflow tasks", "taskDefinitionCount": 4, "expectedExecutionCount": 24 }
          ]
        },
        "nativeAggregate": {
          "const": {
            "required": true,
            "sourceIdentity": "single-head-native",
            "crossRevisionProjectionAllowed": false
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "languageEcosystem", "source", "license", "snapshot"],
      "properties": {
        "id": { "enum": ["express", "preact", "spf13-cobra", "vscode-languageserver-node"] },
        "languageEcosystem": { "enum": ["javascript", "typescript", "go", "web-mixed"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "commit"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$", "maxLength": 300 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "path"],
          "properties": {
            "spdx": { "enum": ["MIT", "Apache-2.0"] },
            "path": { "enum": ["LICENSE", "LICENSE.txt", "License.txt"] }
          }
        },
        "snapshot": {
          "const": {
            "strategy": "pinned-source-overlay",
            "preparationNetwork": "allowlisted-source-only",
            "executionNetwork": "disabled",
            "dependencyPolicy": "pinned-cache-required"
          }
        }
      }
    },
    "failureCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "enum": ["model", "tool", "permission", "platform", "product_workflow", "infrastructure", "fixture", "evaluator"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "aggregation", "source", "description"],
      "properties": {
        "id": {
          "enum": [
            "task_completion_rate",
            "test_pass_rate",
            "patch_acceptance_rate",
            "regression_count",
            "manual_intervention_count",
            "dangerous_operation_block_rate",
            "recovery_success_rate",
            "duration_ms",
            "input_tokens",
            "output_tokens"
          ]
        },
        "aggregation": { "enum": ["boolean_rate", "applicable_boolean_rate", "sum", "distribution", "nullable_sum"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "category",
        "title",
        "executionProfile",
        "platforms",
        "fixture",
        "prompt",
        "evaluator",
        "acceptance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$", "maxLength": 100 },
        "layer": { "enum": ["A", "B", "C"] },
        "repositoryId": { "enum": ["express", "preact", "spf13-cobra", "vscode-languageserver-node"] },
        "category": {
          "enum": [
            "project_rules",
            "cross_file_feature",
            "bug_fix",
            "test_diagnosis",
            "large_repo_navigation",
            "interactive_command",
            "safety_boundary",
            "gateway_recovery",
            "gateway_client_cancellation",
            "gateway_process_restart",
            "git_dirty_worktree",
            "git_delivery_guard",
            "browser_behavior",
            "parallel_read",
            "parallel_write",
            "delivery_reconciliation"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "executionProfile": {
          "enum": ["plan", "navigation-read", "workspace-write", "command-control", "safety-probe", "recovery-control", "git-local"]
        },
        "platforms": {
          "type": "array",
          "prefixItems": [
            { "const": "windows-native" },
            { "const": "wsl2-linux" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generatorId", "version", "resetStrategy"],
          "properties": {
            "generatorId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$", "maxLength": 100 },
            "version": { "type": "integer", "minimum": 1 },
            "resetStrategy": { "const": "regenerate" }
          }
        },
        "prompt": { "type": "string", "minLength": 21, "maxLength": 4000 },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "machine" },
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$", "maxLength": 100 }
          }
        },
        "truthSet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256"],
          "properties": {
            "id": { "const": "real-web-ui-regression-v1" },
            "path": { "const": "benchmarks/coding-agent/v3/real-web-ui-regression-truth-set.json" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      },
      "allOf": [
        {
          "if": { "properties": { "layer": { "const": "B" } }, "required": ["layer"] },
          "then": { "required": ["repositoryId"] },
          "else": { "not": { "required": ["repositoryId"] } }
        },
        {
          "if": { "properties": { "id": { "const": "real-web.ui-regression" } }, "required": ["id"] },
          "then": { "required": ["truthSet"] },
          "else": { "not": { "required": ["truthSet"] } }
        }
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testCommands", "requiredChangedPaths", "allowedChangedPaths", "forbiddenActions"],
      "properties": {
        "testCommands": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "expectedExitCode"],
            "properties": {
              "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "expectedExitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        },
        "requiredChangedPaths": { "$ref": "#/$defs/changedPaths" },
        "allowedChangedPaths": { "$ref": "#/$defs/changedPaths" },
        "forbiddenActions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "network_access",
              "external_path_write",
              "remote_git_write",
              "evidence_delete",
              "workspace_mutation",
              "dangerous_command_execution",
              "subprocess_escape",
              "duplicate_side_effect",
              "user_change_overwrite"
            ]
          }
        }
      }
    },
    "changedPaths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
        "maxLength": 500
      }
    }
  }
}
