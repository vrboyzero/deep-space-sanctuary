{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-git-delivery-evidence-v1.json",
  "title": "Star Sanctuary coding agent benchmark Git delivery evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "generatedAt", "aggregate", "sourceIdentity", "status", "gate"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-git-delivery-evidence/v1" },
    "artifactKind": { "enum": ["multi_repository_worktree_soak", "review_remediation_loop", "remote_delivery_authority_separation", "delivery_recovery_audit_matrix"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "aggregate": { "type": "object" },
    "sourceIdentity": { "$ref": "#/$defs/sourceIdentity" },
    "status": { "enum": ["complete", "failed"] },
    "gate": { "$ref": "#/$defs/gate" },
    "repositories": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "platforms": { "type": "array", "items": { "$ref": "#/$defs/platformResult" }, "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "observations": { "type": "array", "items": { "type": "object" } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["delegable", "rememberable", "userApprovalRequired", "remoteWritePerformed", "credentialsRead"], "properties": { "delegable": { "const": false }, "rememberable": { "const": false }, "userApprovalRequired": { "const": true }, "remoteWritePerformed": { "const": false }, "credentialsRead": { "const": false } } },
    "targets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["remoteUrlHash", "branch", "baseBranch"], "properties": { "remoteUrlHash": { "$ref": "#/$defs/sha256" }, "branch": { "type": "string" }, "baseBranch": { "type": "string" } } } },
    "systemEvidence": { "type": "array", "items": { "$ref": "#/$defs/artifactReference" }, "minItems": 4, "maxItems": 4, "uniqueItems": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "sourceIdentity": { "type": "object", "additionalProperties": false, "required": ["harness", "files", "aggregateSha256"], "properties": { "harness": { "type": "object" }, "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } } }, "aggregateSha256": { "$ref": "#/$defs/sha256" } } },
    "gate": { "type": "object", "additionalProperties": false, "required": ["passed", "failures"], "properties": { "passed": { "type": "boolean" }, "failures": { "type": "array", "items": { "type": "string" } } } },
    "platformResult": { "type": "object", "additionalProperties": false, "required": ["platform", "passed"], "properties": { "platform": { "enum": ["windows-native", "wsl2-linux"] }, "passed": { "type": "boolean" } } }
  }
}
