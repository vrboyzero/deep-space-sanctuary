{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/cli-tui-accessibility-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "platform", "environment", "sourceIdentity", "status", "observation", "accessibility", "lifecycle", "gate"],
  "properties": {
    "schemaVersion": { "const": "tui-accessibility-cross-platform/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "platform": { "enum": ["windows-native", "wsl2-linux"] },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimePlatform", "arch", "release", "nodeVersion", "terminalBackend", "wsl"],
      "properties": {
        "runtimePlatform": { "enum": ["win32", "linux"] },
        "arch": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 },
        "terminalBackend": { "enum": ["conpty", "unix-pty"] },
        "wsl": { "type": "boolean" },
        "distribution": { "type": "string", "minLength": 1 }
      }
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "files", "aggregateSha256"],
      "properties": {
        "harness": { "type": "object" },
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "aggregateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "status": { "enum": ["complete", "incomplete", "failed"] },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sequence", "capturedBytes"],
      "properties": {
        "schemaVersion": { "const": "tui-native-accessibility-observation/v1" },
        "sequence": { "const": 1 },
        "capturedBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["keyboardNavigation", "focusVisible", "labelsPresent"],
      "properties": {
        "keyboardNavigation": { "type": "boolean" },
        "focusVisible": { "type": "boolean" },
        "labelsPresent": { "type": "boolean" }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["firstFrame", "narrowFallback", "wideLayoutRestored", "mouseTabNavigation", "inputReplayRendered", "ctrlCSent", "inputModesRestoredBeforeScreen", "stateDirRemoved", "exitCode", "timedOut", "residualProcessCount"],
      "properties": {
        "firstFrame": { "type": "boolean" },
        "narrowFallback": { "type": "boolean" },
        "wideLayoutRestored": { "type": "boolean" },
        "mouseTabNavigation": { "type": "boolean" },
        "inputReplayRendered": { "type": "boolean" },
        "ctrlCSent": { "type": "boolean" },
        "inputModesRestoredBeforeScreen": { "type": "boolean" },
        "stateDirRemoved": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "residualProcessCount": { "type": "integer", "minimum": 0 }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "failures"],
      "properties": { "passed": { "type": "boolean" }, "failures": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
