{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-expected-reports-v1.json",
  "title": "Star Sanctuary coding agent benchmark retained expected reports v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestSha256", "reports"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-expected-reports/v1" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reportId"],
        "properties": {
          "reportId": { "$ref": "#/$defs/reportId" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reportId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
