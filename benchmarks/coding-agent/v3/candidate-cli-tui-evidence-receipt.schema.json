{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/coding-agent-benchmark-candidate-cli-tui-evidence-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "aggregate", "sourceIdentity", "taskProjection", "efficiency", "accessibility", "summary"],
  "properties": {
    "schemaVersion": { "const": "coding-agent-benchmark-candidate-cli-tui-evidence-receipt/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "aggregate": { "type": "object" },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["harness", "files", "aggregateSha256"],
      "properties": { "harness": { "type": "object" }, "files": { "type": "array", "minItems": 1 }, "aggregateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "taskProjection": { "$ref": "#/$defs/artifactReference" },
    "efficiency": { "$ref": "#/$defs/artifactReference" },
    "accessibility": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/artifactReference" }, { "$ref": "#/$defs/artifactReference" }], "items": false, "minItems": 2, "maxItems": 2 },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["taskProjectionCrossEntryConformance", "taskProjectionTerminalActionConsistency", "taskEfficiencyTimeline", "tuiAccessibilityCrossPlatform"],
      "properties": { "taskProjectionCrossEntryConformance": { "type": "boolean" }, "taskProjectionTerminalActionConsistency": { "type": "boolean" }, "taskEfficiencyTimeline": { "type": "boolean" }, "tuiAccessibilityCrossPlatform": { "type": "boolean" } }
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    }
  }
}
