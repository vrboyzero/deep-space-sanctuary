{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/tui-performance-baseline-v1.json",
  "title": "Star Sanctuary TUI Performance Baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "minimumSampleCount", "regressionPolicy", "platforms"],
  "properties": {
    "schemaVersion": { "const": "tui-performance-baseline/v1" },
    "minimumSampleCount": { "type": "integer", "minimum": 5 },
    "regressionPolicy": { "$ref": "#/definitions/regressionPolicy" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-native", "wsl2-linux"],
      "properties": {
        "windows-native": { "$ref": "#/definitions/platformBaseline" },
        "wsl2-linux": { "$ref": "#/definitions/platformBaseline" }
      }
    }
  },
  "definitions": {
    "regressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p99Ratio", "p99AllowanceMs", "jitterRateRatio", "jitterRateAllowance"],
      "properties": {
        "p99Ratio": { "type": "number", "exclusiveMinimum": 0 },
        "p99AllowanceMs": { "type": "number", "minimum": 0 },
        "jitterRateRatio": { "type": "number", "exclusiveMinimum": 0 },
        "jitterRateAllowance": { "type": "number", "minimum": 0 }
      }
    },
    "platformBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "sourceCommit", "sourceWorkspaceDirty", "environment", "metrics"],
      "properties": {
        "capturedAt": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "sourceWorkspaceDirty": { "type": "boolean" },
        "environment": { "$ref": "#/definitions/environment" },
        "metrics": { "$ref": "#/definitions/baselineMetrics" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "release", "nodeVersion", "terminalBackend", "wsl"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 },
        "terminalBackend": { "enum": ["conpty", "unix-pty"] },
        "wsl": { "type": "boolean" },
        "distribution": { "type": "string", "minLength": 1 }
      }
    },
    "baselineMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "resize", "inputReplay", "exit"],
      "properties": {
        "startup": { "$ref": "#/definitions/baselineMetric" },
        "resize": { "$ref": "#/definitions/baselineMetric" },
        "inputReplay": { "$ref": "#/definitions/baselineMetric" },
        "exit": { "$ref": "#/definitions/baselineMetric" }
      }
    },
    "baselineMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p99Ms", "jitterRate"],
      "properties": {
        "p99Ms": { "type": "number", "exclusiveMinimum": 0 },
        "jitterRate": { "type": "number", "minimum": 0 }
      }
    }
  }
}
