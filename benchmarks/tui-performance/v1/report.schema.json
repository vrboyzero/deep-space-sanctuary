{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/tui-performance-report-v1.json",
  "title": "Star Sanctuary TUI Performance Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "fixture", "platforms", "gate"],
  "properties": {
    "schemaVersion": { "const": "tui-performance-report/v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "workspaceDirty"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "workspaceDirty": { "type": "boolean" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmupRuns", "sampleRuns", "replayCharacterCount"],
      "properties": {
        "warmupRuns": { "type": "integer", "minimum": 0 },
        "sampleRuns": { "type": "integer", "minimum": 5 },
        "replayCharacterCount": { "type": "integer", "minimum": 12 }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/definitions/platformResult" }
    },
    "gate": { "$ref": "#/definitions/simpleGate" }
  },
  "definitions": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "release", "nodeVersion", "terminalBackend", "wsl"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "minLength": 1 },
        "terminalBackend": { "enum": ["conpty", "unix-pty"] },
        "wsl": { "type": "boolean" },
        "distribution": { "type": "string", "minLength": 1 }
      }
    },
    "durations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "resize", "inputReplay", "exit"],
      "properties": {
        "startup": { "type": "number", "exclusiveMinimum": 0 },
        "resize": { "type": "number", "exclusiveMinimum": 0 },
        "inputReplay": { "type": "number", "exclusiveMinimum": 0 },
        "exit": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstFrame", "narrowFallback", "wideLayoutRestored", "mouseTabNavigation", "inputReplayRendered", "ctrlCSent", "bracketedPasteRestored", "mouseTrackingRestored", "sgrMouseRestored", "alternateScreenRestored", "inputModesRestoredBeforeScreen", "stateDirRemoved", "exitCode", "timedOut", "observedProcessCount", "residualProcessCount"],
      "properties": {
        "firstFrame": { "const": true },
        "narrowFallback": { "const": true },
        "wideLayoutRestored": { "const": true },
        "mouseTabNavigation": { "const": true },
        "inputReplayRendered": { "const": true },
        "ctrlCSent": { "const": true },
        "bracketedPasteRestored": { "const": true },
        "mouseTrackingRestored": { "const": true },
        "sgrMouseRestored": { "const": true },
        "alternateScreenRestored": { "const": true },
        "inputModesRestoredBeforeScreen": { "const": true },
        "stateDirRemoved": { "const": true },
        "exitCode": { "const": 0 },
        "timedOut": { "const": false },
        "observedProcessCount": { "type": "integer", "minimum": 1 },
        "residualProcessCount": { "const": 0 }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "durationsMs", "capturedBytes", "lifecycle"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "durationsMs": { "$ref": "#/definitions/durations" },
        "capturedBytes": { "type": "integer", "minimum": 1 },
        "lifecycle": { "$ref": "#/definitions/lifecycle" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "sampleCount", "minMs", "maxMs", "meanMs", "p50Ms", "p95Ms", "p99Ms", "jitterRate", "percentileMethod", "jitterFormula"],
      "properties": {
        "unit": { "const": "milliseconds" },
        "sampleCount": { "type": "integer", "minimum": 5 },
        "minMs": { "type": "number", "exclusiveMinimum": 0 },
        "maxMs": { "type": "number", "exclusiveMinimum": 0 },
        "meanMs": { "type": "number", "exclusiveMinimum": 0 },
        "p50Ms": { "type": "number", "exclusiveMinimum": 0 },
        "p95Ms": { "type": "number", "exclusiveMinimum": 0 },
        "p99Ms": { "type": "number", "exclusiveMinimum": 0 },
        "jitterRate": { "type": "number", "minimum": 0 },
        "percentileMethod": { "const": "nearest-rank" },
        "jitterFormula": { "const": "(p99-p50)/max(p50,1ms)" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "resize", "inputReplay", "exit"],
      "properties": {
        "startup": { "$ref": "#/definitions/summary" },
        "resize": { "$ref": "#/definitions/summary" },
        "inputReplay": { "$ref": "#/definitions/summary" },
        "exit": { "$ref": "#/definitions/summary" }
      }
    },
    "simpleGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failures"],
      "properties": {
        "passed": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p99Ratio", "p99AllowanceMs", "jitterRateRatio", "jitterRateAllowance"],
      "properties": {
        "p99Ratio": { "type": "number", "exclusiveMinimum": 0 },
        "p99AllowanceMs": { "type": "number", "minimum": 0 },
        "jitterRateRatio": { "type": "number", "exclusiveMinimum": 0 },
        "jitterRateAllowance": { "type": "number", "minimum": 0 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedP99Ms", "baselineP99Ms", "p99LimitMs", "observedJitterRate", "baselineJitterRate", "jitterRateLimit"],
      "properties": {
        "observedP99Ms": { "type": "number", "minimum": 0 },
        "baselineP99Ms": { "type": "number", "minimum": 0 },
        "p99LimitMs": { "type": "number", "minimum": 0 },
        "observedJitterRate": { "type": "number", "minimum": 0 },
        "baselineJitterRate": { "type": "number", "minimum": 0 },
        "jitterRateLimit": { "type": "number", "minimum": 0 }
      }
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "resize", "inputReplay", "exit"],
      "properties": {
        "startup": { "$ref": "#/definitions/comparison" },
        "resize": { "$ref": "#/definitions/comparison" },
        "inputReplay": { "$ref": "#/definitions/comparison" },
        "exit": { "$ref": "#/definitions/comparison" }
      }
    },
    "historicalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "baselineSchemaVersion", "baselineCapturedAt", "baselineSourceCommit", "policy", "comparisons", "passed", "failures"],
      "properties": {
        "schemaVersion": { "const": "tui-performance-gate/v1" },
        "baselineSchemaVersion": { "const": "tui-performance-baseline/v1" },
        "baselineCapturedAt": { "type": "string", "minLength": 1 },
        "baselineSourceCommit": { "type": "string", "minLength": 1 },
        "policy": { "$ref": "#/definitions/policy" },
        "comparisons": { "$ref": "#/definitions/comparisons" },
        "passed": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "platformResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "environment", "sampleCount", "samples", "metrics", "lifecycle", "gate"],
      "properties": {
        "platform": { "enum": ["windows-native", "wsl2-linux"] },
        "environment": { "$ref": "#/definitions/environment" },
        "sampleCount": { "type": "integer", "minimum": 5 },
        "samples": { "type": "array", "minItems": 5, "items": { "$ref": "#/definitions/sample" } },
        "metrics": { "$ref": "#/definitions/metrics" },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allSamplesPassed", "observedProcessCount", "residualProcessCount"],
          "properties": {
            "allSamplesPassed": { "const": true },
            "observedProcessCount": { "type": "integer", "minimum": 5 },
            "residualProcessCount": { "const": 0 }
          }
        },
        "gate": { "$ref": "#/definitions/historicalGate" }
      }
    }
  }
}
