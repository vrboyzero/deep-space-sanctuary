{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.dev/schemas/verification-impact-truth-set-v1.json",
  "title": "Star Sanctuary verification impact truth set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "contractVersion", "thresholds", "verificationCommands", "browser", "cases"],
  "properties": {
    "schemaVersion": { "const": "verification-impact-truth-set/v1" },
    "id": { "$ref": "#/$defs/id" },
    "contractVersion": { "const": "verification-impact/v1" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "exactCaseRate"],
      "properties": {
        "precision": { "type": "number", "minimum": 0.95, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0.95, "maximum": 1 },
        "exactCaseRate": { "type": "number", "minimum": 0.95, "maximum": 1 }
      }
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/command" }
    },
    "browser": { "$ref": "#/$defs/browser" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command", "affectedPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["acceptance", "build", "typecheck", "lint", "browser", "manual"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "affectedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "required": { "type": "boolean" },
        "scope": { "enum": ["targeted", "module", "full", "browser"] }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "affectedPaths", "command"],
      "properties": {
        "required": { "const": true },
        "affectedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "command": { "type": "null" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "expanded", "reason"],
      "properties": {
        "scope": { "enum": ["targeted", "expanded", "browser"] },
        "expanded": { "type": "boolean" },
        "reason": { "enum": ["affected-paths", "scope-unavailable", "impact-unknown", "impact-evidence", "browser-required", "no-nodes"] }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "changedPaths", "expectedNodeIds", "expectedSelection"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "expectedNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "expectedSelection": { "$ref": "#/$defs/selection" }
      }
    }
  }
}
