{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.local/schemas/code-intel/agent-uplift-report-v1.schema.json",
  "title": "Star Sanctuary CodeIntel Agent uplift aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "status", "candidateId", "authorization", "platforms", "gate", "pairs"],
  "properties": {
    "schemaVersion": { "const": "code-intel-agent-uplift-report/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "blocked"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "candidateId": { "const": "code-intel-semantic-live-v1" },
    "authorization": { "$ref": "#/$defs/aggregateAuthorization" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowsNative", "wsl2Linux"],
      "properties": {
        "windowsNative": { "$ref": "#/$defs/platformSummary" },
        "wsl2Linux": { "$ref": "#/$defs/platformSummary" }
      }
    },
    "gate": { "$ref": "#/$defs/gate" },
    "pairs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/pair" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "workspaceDirty", "lockfileSha256", "worktreeContentSha256"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "workspaceDirty": { "type": "boolean" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "worktreeContentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "events", "codingCiManifest", "patch", "result", "repositorySnapshotReceipt"],
      "properties": {
        "report": { "$ref": "#/$defs/artifactRef" },
        "events": { "$ref": "#/$defs/artifactRef" },
        "codingCiManifest": { "$ref": "#/$defs/artifactRef" },
        "patch": { "$ref": "#/$defs/artifactRef" },
        "result": { "$ref": "#/$defs/artifactRef" },
        "repositorySnapshotReceipt": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptSha256", "fixtureBaselineCommit", "repositoryReceiptSha256", "source", "harness", "model", "executionProfile", "maxTokens"],
      "properties": {
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "fixtureBaselineCommit": { "$ref": "#/$defs/sha1" },
        "repositoryReceiptSha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/source" },
        "harness": { "$ref": "#/$defs/source" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "executionProfile": { "enum": ["workspace-write", "command-control"] },
        "maxTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskSuccess", "patchAcceptance", "testSuccess", "regressionCount"],
      "properties": {
        "taskSuccess": { "type": "boolean" },
        "patchAcceptance": { "type": "boolean" },
        "testSuccess": { "type": "boolean" },
        "regressionCount": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageStatus", "inputTokens", "outputTokens", "costUsd", "failure", "terminalErrorCode"],
      "properties": {
        "usageStatus": { "enum": ["provider_reported", "unavailable", "not_reached"] },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "costUsd": { "type": ["number", "null"], "minimum": 0 },
        "failure": { "type": "boolean" },
        "terminalErrorCode": { "type": ["string", "null"] }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successfulRun", "successfulCallCount", "failedCallCount", "capabilities"],
      "properties": {
        "successfulRun": { "type": "boolean" },
        "successfulCallCount": { "type": "integer", "minimum": 0 },
        "failedCallCount": { "type": "integer", "minimum": 0 },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contextWaste": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelVisibleNavigationBytes", "nonTargetWholeFileReadCalls", "firstMutationTool"],
      "properties": {
        "modelVisibleNavigationBytes": { "type": "integer", "minimum": 0 },
        "nonTargetWholeFileReadCalls": { "type": "integer", "minimum": 0 },
        "firstMutationTool": { "type": ["string", "null"], "enum": ["file_edit", "apply_patch", "file_write", "file_delete", null] }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "variant", "taskId", "runId", "status", "failureCategory", "identity", "outcomes", "provider", "semantic", "contextWaste", "artifacts"],
      "properties": {
        "cellId": { "type": "string", "minLength": 1 },
        "variant": { "enum": ["baseline", "candidate"] },
        "taskId": { "enum": ["real-ts.api-migration", "real-ts.cross-package-refactor", "real-js.bug-fix", "real-js.failed-test-fix"] },
        "runId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "blocked", "infrastructure_error"] },
        "failureCategory": { "type": ["string", "null"] },
        "identity": { "$ref": "#/$defs/identity" },
        "outcomes": { "$ref": "#/$defs/outcomes" },
        "provider": { "$ref": "#/$defs/provider" },
        "semantic": { "$ref": "#/$defs/semantic" },
        "contextWaste": { "$ref": "#/$defs/contextWaste" },
        "artifacts": { "$ref": "#/$defs/artifacts" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairId", "taskId", "repositoryId", "executionProfile", "baseline", "candidate"],
      "properties": {
        "pairId": { "type": "string", "minLength": 1 },
        "taskId": { "enum": ["real-ts.api-migration", "real-ts.cross-package-refactor", "real-js.bug-fix", "real-js.failed-test-fix"] },
        "repositoryId": { "enum": ["express", "vscode-languageserver-node"] },
        "executionProfile": { "enum": ["workspace-write", "command-control"] },
        "baseline": { "$ref": "#/$defs/cell" },
        "candidate": { "$ref": "#/$defs/cell" }
      }
    },
    "aggregateAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "maxTotalCostCny", "priorObservedCostCny", "runCostCny", "totalObservedCostCny", "remainingCostCny", "exchangeRateCnyPerUsd"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "const": "deepseek-v4-flash" },
        "maxTotalCostCny": { "type": "number", "exclusiveMinimum": 0, "maximum": 40 },
        "priorObservedCostCny": { "type": "number", "minimum": 0 },
        "runCostCny": { "type": "number", "minimum": 0 },
        "totalObservedCostCny": { "type": "number", "minimum": 0 },
        "remainingCostCny": { "type": "number", "minimum": 0 },
        "exchangeRateCnyPerUsd": { "const": 8 }
      }
    },
    "platformSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reportSha256", "pairCount", "executedCellCount", "runCostCny"],
      "properties": {
        "status": { "enum": ["completed", "blocked"] },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "pairCount": { "type": "integer", "minimum": 0, "maximum": 4 },
        "executedCellCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "runCostCny": { "type": "number", "minimum": 0 }
      }
    },
    "metricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "relativeReduction"],
      "properties": {
        "baseline": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 },
        "relativeReduction": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "readMetricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "relativeReduction", "absoluteReduction"],
      "properties": {
        "baseline": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 },
        "relativeReduction": { "type": "number", "minimum": -1, "maximum": 1 },
        "absoluteReduction": { "type": "integer" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failures", "pairCount", "regressionCount", "providerFailureCount", "semanticSuccessfulRuns", "semanticSuccessfulRunsByPlatform", "contextWaste"],
      "properties": {
        "passed": { "type": "boolean" },
        "failures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pairCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "regressionCount": { "type": "integer", "minimum": 0 },
        "providerFailureCount": { "type": "integer", "minimum": 0 },
        "semanticSuccessfulRuns": { "type": "integer", "minimum": 0, "maximum": 8 },
        "semanticSuccessfulRunsByPlatform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows-native", "wsl2-linux"],
          "properties": {
            "windows-native": { "type": "integer", "minimum": 0, "maximum": 4 },
            "wsl2-linux": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        "contextWaste": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelVisibleNavigationBytes", "nonTargetWholeFileReadCalls", "noRegression", "improvementAlternativePassed"],
          "properties": {
            "modelVisibleNavigationBytes": { "$ref": "#/$defs/metricComparison" },
            "nonTargetWholeFileReadCalls": { "$ref": "#/$defs/readMetricComparison" },
            "noRegression": { "type": "boolean" },
            "improvementAlternativePassed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
