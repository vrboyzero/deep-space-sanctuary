{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-sanctuary.local/schemas/code-intel/agent-uplift-readiness-v1.schema.json",
  "title": "Star Sanctuary CodeIntel Agent uplift readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "status", "platform", "candidateId", "gate",
    "taskManifest", "truthSet", "repositoryInputs", "sourceIdentity", "runtimeIdentity",
    "profileBindings", "pairMatrix", "preparedPairs", "repositories", "authorization", "execution"
  ],
  "properties": {
    "schemaVersion": { "const": "code-intel-agent-uplift-readiness/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "ready_for_authorization" },
    "platform": { "$ref": "#/$defs/platform" },
    "candidateId": { "const": "code-intel-semantic-live-v1" },
    "gate": { "$ref": "#/$defs/namedSource" },
    "taskManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "path", "sha256"],
      "properties": {
        "schemaVersion": { "const": "coding-agent-benchmark-manifest/v3" },
        "path": { "const": "benchmarks/coding-agent/v3/task-manifest.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "truthSet": { "$ref": "#/$defs/namedSource" },
    "repositoryInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": { "const": "coding-agent-benchmark-repository-inputs/v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceIdentity": { "$ref": "#/$defs/fileIdentity" },
    "runtimeIdentity": { "$ref": "#/$defs/fileIdentity" },
    "profileBindings": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/profileBinding" }
    },
    "pairMatrix": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": { "$ref": "#/$defs/pair" }
    },
    "preparedPairs": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/pair" },
          {
            "type": "object",
            "required": ["receiptSha256"],
            "properties": { "receiptSha256": { "$ref": "#/$defs/sha256" } }
          }
        ]
      }
    },
    "repositories": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/repository" }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "providerAuthorizationRequired", "previousP0AuthorizationApplicable", "credentialsRead"],
      "properties": {
        "status": { "const": "pending_explicit_user_authorization" },
        "providerAuthorizationRequired": { "const": true },
        "previousP0AuthorizationApplicable": { "const": false },
        "credentialsRead": { "const": false }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mode", "gatewayCalls", "modelCalls", "paidProviderCalls", "codeIntelProviderQueries",
        "networkCalls", "hostCommandToolCalls", "credentialsRead", "productionWorkspaceMutations"
      ],
      "properties": {
        "mode": { "const": "dry-run" },
        "gatewayCalls": { "const": 0 },
        "modelCalls": { "const": 0 },
        "paidProviderCalls": { "const": 0 },
        "codeIntelProviderQueries": { "const": 0 },
        "networkCalls": { "const": 0 },
        "hostCommandToolCalls": { "const": 0 },
        "credentialsRead": { "const": false },
        "productionWorkspaceMutations": { "const": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform": { "enum": ["windows-native", "wsl2-linux"] },
    "namedSource": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "aggregateSha256"],
      "properties": {
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "aggregateSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionMode", "toolAllow", "toolDeny"],
      "properties": {
        "agentId": { "type": "string" },
        "maxHighRiskToolCalls": { "type": "integer", "minimum": 0 },
        "permissionMode": { "type": "string" },
        "toolAllow": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "toolDeny": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "toolArgumentPolicy": { "type": "string" }
      }
    },
    "profileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "baseline", "candidate", "differences"],
      "properties": {
        "mode": { "enum": ["workspace-write", "command-control"] },
        "baseline": { "$ref": "#/$defs/profile" },
        "candidate": { "$ref": "#/$defs/profile" },
        "differences": {
          "const": [{ "path": "toolAllow", "operation": "append", "value": "code_intel" }]
        }
      }
    },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pairId", "platform", "attempt", "taskId", "repositoryId", "executionProfile",
        "promptSha256", "baseline", "candidate"
      ],
      "properties": {
        "pairId": { "type": "string", "minLength": 1 },
        "platform": { "$ref": "#/$defs/platform" },
        "attempt": { "const": 1 },
        "taskId": { "enum": ["real-ts.api-migration", "real-ts.cross-package-refactor", "real-js.bug-fix", "real-js.failed-test-fix"] },
        "repositoryId": { "enum": ["express", "vscode-languageserver-node"] },
        "executionProfile": { "enum": ["workspace-write", "command-control"] },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["cellId", "profileSource"],
          "properties": {
            "cellId": { "type": "string", "minLength": 1 },
            "profileSource": { "const": "frozen-task-manifest-v3" }
          }
        },
        "candidate": {
          "type": "object", "additionalProperties": false,
          "required": ["cellId", "profileId"],
          "properties": {
            "cellId": { "type": "string", "minLength": 1 },
            "profileId": { "const": "code-intel-semantic-live-v1" }
          }
        },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "receiptSha256", "source", "license", "dependencyCache", "policy", "preflight", "directories"],
      "properties": {
        "repositoryId": { "enum": ["express", "vscode-languageserver-node"] },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/repositorySource" },
        "license": { "$ref": "#/$defs/license" },
        "dependencyCache": { "$ref": "#/$defs/dependencyCache" },
        "policy": { "$ref": "#/$defs/repositoryPolicy" },
        "preflight": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "taskId"],
          "properties": {
            "status": { "const": "passed" },
            "taskId": { "enum": ["real-ts.api-migration", "real-js.bug-fix"] }
          }
        },
        "directories": {
          "type": "object", "additionalProperties": false,
          "required": ["repositoryRoot", "dependencyCacheRoot"],
          "properties": {
            "repositoryRoot": { "const": "available" },
            "dependencyCacheRoot": { "const": "available" }
          }
        }
      }
    },
    "repositorySource": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "commit", "workspaceDirty", "worktreeContentSha256", "dependencyInputsSha256"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "workspaceDirty": { "const": false },
        "worktreeContentSha256": { "$ref": "#/$defs/sha256" },
        "dependencyInputsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "path", "sha256"],
      "properties": {
        "spdx": { "const": "MIT" },
        "path": { "enum": ["LICENSE", "License.txt"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyCache": {
      "type": "object", "additionalProperties": false,
      "required": ["cacheKey", "contentSha256"],
      "properties": {
        "cacheKey": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repositoryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["preparationNetwork", "executionNetwork", "dependencyPolicy"],
      "properties": {
        "preparationNetwork": { "const": "allowlisted-source-only" },
        "executionNetwork": { "const": "disabled" },
        "dependencyPolicy": { "const": "pinned-cache-required" }
      }
    }
  }
}
