{
  "name": "star-sanctuary",
  "version": "0.5.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "clean:release-artifacts": "node scripts/clean-release-artifacts.mjs",
    "clean:release-artifacts:all": "node scripts/clean-release-artifacts.mjs --purge-cache",
    "version:generate": "node scripts/generate-version.mjs",
    "build:web-assets": "node scripts/build-web-assets.mjs",
    "prebuild": "pnpm run version:generate && pnpm run build:web-assets",
    "predev": "pnpm run version:generate && pnpm run build:web-assets",
    "predev:gateway": "pnpm run build:web-assets",
    "pretest": "pnpm run version:generate && pnpm run build:web-assets",
    "preverify:webchat": "pnpm run build:web-assets",
    "preverify:webchat:security": "pnpm run build:web-assets",
    "prestart": "pnpm run build:web-assets",
    "prebdd": "pnpm run build:web-assets",
    "build:incremental": "tsc -b",
    "build:force": "tsc -b --force",
    "verify:build": "node scripts/verify-workspace-build.mjs",
    "verify:webchat": "node scripts/verify-webchat-modules.mjs",
    "verify:webchat:security": "node scripts/verify-webchat-security-policy.mjs",
    "build": "pnpm run build:incremental && pnpm run verify:build",
    "benchmark:build": "node scripts/run-build-benchmark.mjs",
    "benchmark:memory-sqlite": "node --import tsx scripts/run-memory-sqlite-benchmark.mjs",
    "benchmark:agent-mock": "node --import tsx scripts/run-agent-mock-benchmark.mjs",
    "benchmark:channel-ingress": "node --import tsx scripts/run-channel-ingress-benchmark.mjs",
    "benchmark:tool-catalog": "node --import tsx scripts/run-tool-catalog-benchmark.mjs",
    "benchmark:mcp-in-memory": "node --import tsx scripts/run-mcp-in-memory-benchmark.mjs",
    "benchmark:browser-relay": "node scripts/run-browser-relay-benchmark.mjs",
    "benchmark:webchat-fixture": "node scripts/run-webchat-fixed-fixture-benchmark.mjs",
    "prebuild:release-light": "pnpm run build:web-assets",
    "build:release-light": "node scripts/build-release-light-assets.mjs",
    "prebuild:winget": "pnpm run build:web-assets",
    "build:winget": "node scripts/build-winget-assets.mjs",
    "prebuild:portable": "pnpm run build:web-assets",
    "build:portable": "node packages/star-sanctuary-distribution/scripts/build-portable.mjs",
    "prebuild:portable:full": "pnpm run build:web-assets",
    "build:portable:full": "node packages/star-sanctuary-distribution/scripts/build-portable.mjs --mode full",
    "prefetch:portable": "node packages/star-sanctuary-distribution/scripts/prefetch-portable-deps.mjs",
    "prefetch:portable:full": "node packages/star-sanctuary-distribution/scripts/prefetch-portable-deps.mjs --mode full",
    "prebuild:single-exe": "pnpm run build:web-assets",
    "build:single-exe": "node packages/star-sanctuary-distribution/scripts/build-single-exe.mjs --mode full",
    "prebuild:single-exe:full": "pnpm run build:web-assets",
    "build:single-exe:full": "node packages/star-sanctuary-distribution/scripts/build-single-exe.mjs --mode full",
    "smoke:install-lifecycle": "node packages/star-sanctuary-distribution/scripts/smoke-install-lifecycle.mjs",
    "smoke:install-script-build": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-build.mjs",
    "smoke:install-script-rollback": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-rollback.mjs",
    "smoke:install-script-rollback:real": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-rollback-real.mjs",
    "smoke:install-script-lifecycle": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-lifecycle.mjs",
    "smoke:install-script-upgrade-handoff": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-upgrade-handoff.mjs",
    "smoke:console-watch": "node scripts/smoke-console-watch.mjs",
    "smoke:install-script-build:wsl": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-build-wsl.mjs",
    "smoke:install-script-lifecycle:wsl": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-lifecycle-wsl.mjs",
    "smoke:install-script-rollback:wsl": "node packages/star-sanctuary-distribution/scripts/smoke-install-script-rollback-wsl.mjs",
    "smoke:start-sh-envdir:wsl": "node packages/star-sanctuary-distribution/scripts/smoke-start-sh-envdir-wsl.mjs",
    "smoke:install-journey": "node packages/star-sanctuary-distribution/scripts/smoke-install-journey.mjs",
    "smoke:install-state": "node packages/star-sanctuary-distribution/scripts/smoke-install-state.mjs",
    "smoke:portable": "node packages/star-sanctuary-distribution/scripts/smoke-portable.mjs",
    "smoke:portable:full": "node packages/star-sanctuary-distribution/scripts/smoke-portable.mjs --mode full",
    "smoke:single-exe": "node packages/star-sanctuary-distribution/scripts/smoke-single-exe.mjs --mode full",
    "smoke:single-exe:full": "node packages/star-sanctuary-distribution/scripts/smoke-single-exe.mjs --mode full",
    "verify:portable-lifecycle": "node packages/star-sanctuary-distribution/scripts/verify-portable-lifecycle.mjs",
    "verify:portable-lifecycle:full": "node packages/star-sanctuary-distribution/scripts/verify-portable-lifecycle.mjs --mode full",
    "verify:single-exe-lifecycle": "node packages/star-sanctuary-distribution/scripts/verify-single-exe-lifecycle.mjs --mode full",
    "verify:single-exe-lifecycle:full": "node packages/star-sanctuary-distribution/scripts/verify-single-exe-lifecycle.mjs --mode full",
    "verify:portable-deps": "node packages/star-sanctuary-distribution/scripts/verify-portable-deps.mjs",
    "verify:portable-deps:full": "node packages/star-sanctuary-distribution/scripts/verify-portable-deps.mjs --mode full",
    "verify:portable-artifacts": "node packages/star-sanctuary-distribution/scripts/verify-portable-artifacts.mjs",
    "verify:portable-artifacts:full": "node packages/star-sanctuary-distribution/scripts/verify-portable-artifacts.mjs --mode full",
    "verify:release-light": "node scripts/verify-release-light-assets.mjs",
    "verify:winget": "node scripts/verify-winget-assets.mjs",
    "verify:single-exe-deps": "node packages/star-sanctuary-distribution/scripts/verify-single-exe-deps.mjs --mode full",
    "verify:single-exe-deps:full": "node packages/star-sanctuary-distribution/scripts/verify-single-exe-deps.mjs --mode full",
    "rebuild": "pnpm run clean:build && pnpm run build",
    "postbuild": "node -e \"fs.cpSync('packages/belldandy-agent/src/templates', 'packages/belldandy-agent/dist/templates', {recursive:true, force:true})\"",
    "bdd": "node --import tsx packages/belldandy-core/src/bin/bdd.ts",
    "start": "node packages/belldandy-core/dist/bin/bdd.js start",
    "dev": "node --import tsx packages/belldandy-core/src/bin/bdd.ts dev",
    "dev:gateway": "node --import tsx packages/belldandy-core/src/bin/bdd.ts dev",
    "test": "vitest run"
  },
  "pnpm": {
    "overrides": {
      "fastembed@2.1.0>tar": "7.5.20",
      "onnxruntime-node@1.21.0>tar": "7.5.20",
      "vite": "6.4.3",
      "vite@6.4.3>postcss": "8.5.19",
      "vite@6.4.3>rollup": "4.62.2"
    },
    "patchedDependencies": {
      "fastembed@2.1.0": "patches/fastembed@2.1.0.patch"
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.1",
    "dagre": "0.8.5",
    "dompurify": "^3.4.12",
    "esbuild": "^0.25.10",
    "marked": "12.0.2",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  }
}
