# ============================================
# Star Sanctuary 环境变量配置模板
# ============================================
# 使用说明：
# 1. 本地开发：复制为 .env.local（Git 忽略）
# 2. Docker 部署：复制为 .env
# 3. 填写必需的配置项（标记为 REQUIRED）
# 4. 顶层按 5 个模块组织；模块内继续保留原有专题小节，便于按需查阅
#
# 模块索引：
# 1) 基础运行、部署与安全接入
# 2) 模型、Prompt 与会话编排
# 3) 记忆、检索与经验沉淀
# 4) 工具、多媒体与执行控制
# 5) 自动化、渠道与运行治理

# ==================================================
# 模块 1 / 5：基础运行、部署与安全接入
# ==================================================
# ========================================
# Docker 镜像配置（仅 Docker 部署需要）
# ========================================
BELLDANDY_IMAGE=vrboyzero/star-sanctuary:local

# ========================================
# 网络配置
# ========================================
# 绑定地址（127.0.0.1=仅本机，0.0.0.0=允许局域网访问）
BELLDANDY_HOST=127.0.0.1

# Gateway 端口
BELLDANDY_PORT=28889
BELLDANDY_GATEWAY_PORT=28889  # Docker Compose 使用此变量

# 显式指定环境配置目录（可选，优先级最高）
# 设置后，会直接从该目录读取 .env / .env.local，不再自动在 project-root / state-dir 之间择一
# STAR_SANCTUARY_ENV_DIR=E:\project\star-sanctuary
# BELLDANDY_ENV_DIR=E:\project\star-sanctuary

# 版本检查（默认开启，仅日志提示，不自动升级）
BELLDANDY_UPDATE_CHECK=true
# BELLDANDY_UPDATE_CHECK_TIMEOUT_MS=3000
# BELLDANDY_UPDATE_CHECK_API_URL=https://api.github.com/repos/vrboyzero/star-sanctuary/releases/latest

# ========================================
# 认证配置（REQUIRED）
# ========================================
# 认证模式: none / token / password（默认 none）
# 注意：即使是 none，新设备连接也需要 Pairing 配对
# 警告：使用 0.0.0.0 时禁止使用 none 模式
BELLDANDY_AUTH_MODE=none

# Token 认证（当 AUTH_MODE=token 时必填）
# 生成方法: openssl rand -hex 32
BELLDANDY_AUTH_TOKEN=your_token_here

# 密码认证（当 AUTH_MODE=password 时必填）
# BELLDANDY_AUTH_PASSWORD=your-secure-password-here

# Community API（/api/message）配置
# 默认关闭；仅在需要被 office.goddess.ai 等 HTTP 调用时开启
# 安全约束：当 BELLDANDY_COMMUNITY_API_ENABLED=true 时，BELLDANDY_AUTH_MODE 不能为 none（建议 token）
BELLDANDY_COMMUNITY_API_ENABLED=false
# 社区 API 专用 token（推荐与 AUTH_TOKEN 区分）
# 不设置时会回退到 BELLDANDY_AUTH_TOKEN
# BELLDANDY_COMMUNITY_API_TOKEN=your-community-api-token
# 调用方需携带请求头：
# Authorization: Bearer <BELLDANDY_COMMUNITY_API_TOKEN>
# 示例（本地联调）：
# curl -X POST http://127.0.0.1:28889/api/message -H "Authorization: Bearer your-community-api-token" -H "Content-Type: application/json" -d "{\"text\":\"hello\",\"conversationId\":\"conv-1\"}"

# Webhook ingress guard（/api/webhook/:id）
# 作用：在 token 校验之前，先做 JSON content-type、body size、读取超时、限流、并发保护
# pre-auth body 大小上限（字节，默认 65536）
# BELLDANDY_WEBHOOK_PREAUTH_MAX_BYTES=65536
# pre-auth body 读取超时（毫秒，默认 5000）
# BELLDANDY_WEBHOOK_PREAUTH_TIMEOUT_MS=5000
# 固定窗口限流窗口（毫秒，默认 60000）
# BELLDANDY_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# 单个来源在一个窗口内允许的 webhook 请求数（默认 120）
# BELLDANDY_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=120
# 内存中最多跟踪的限流 key 数（默认 4096）
# BELLDANDY_WEBHOOK_RATE_LIMIT_MAX_TRACKED_KEYS=4096
# 单个来源允许同时进行的 webhook 请求数（默认 8）
# BELLDANDY_WEBHOOK_MAX_IN_FLIGHT_PER_KEY=8
# 内存中最多跟踪的并发 key 数（默认 4096）
# BELLDANDY_WEBHOOK_MAX_IN_FLIGHT_TRACKED_KEYS=4096

# Token 消耗上传到 office.goddess.ai（默认关闭）
# 作用：把每次新增的 token 消耗（delta）上报给 office 的 /api/internal/token-usage
# 使用步骤（通俗版）：
# 1) 先把 ENABLED 改成 true
# 2) URL 填 office 后端地址（通常是 http://127.0.0.1:3001/api/internal/token-usage）
# 3) APIKEY 填“该用户在 office.goddess.ai 里生成的 API Key 明文（gro_...）”
# 4) Star Sanctuary 会自动带请求头：Authorization: Bearer <APIKEY>
# 5) office 后端会用这个 API Key 反查归属用户并累计到该用户账号
BELLDANDY_TOKEN_USAGE_UPLOAD_ENABLED=false
# 接收端接口（office 内部路由）
# BELLDANDY_TOKEN_USAGE_UPLOAD_URL=http://127.0.0.1:3001/api/internal/token-usage
# 上传鉴权 API Key（推荐：每用户独立 key，便于单独吊销）
# BELLDANDY_TOKEN_USAGE_UPLOAD_APIKEY=gro_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 向后兼容别名；若历史部署仍使用旧键名，可继续保留
# BELLDANDY_TOKEN_USAGE_UPLOAD_TOKEN=gro_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 上传超时（毫秒，默认 3000）
# BELLDANDY_TOKEN_USAGE_UPLOAD_TIMEOUT_MS=3000
# 任务结束时是否自动附带本次 run 的耗时统计（默认 false）
# 开启后，会在最终回复后追加“执行统计”块
# BELLDANDY_AUTO_TASK_TIME_ENABLED=false
# 任务结束时是否自动附带本次 run 的 token 统计（默认 false）
# 开启后，会在最终回复后追加“执行统计”块
# BELLDANDY_AUTO_TASK_TOKEN_ENABLED=false
# community 上传是否启用“严格 UUID 模式”（默认 false）
# - true：若未从根目录 IDENTITY.md 解析到“主人UUID”，community 上报在接收端 strict uuid 校验开启时可能失败
# - false：即使缺少主人 UUID 也继续上传（请求体不带 userUuid）
# 建议：接收端开启 strict uuid 校验时设为 true，并确保根目录 IDENTITY.md 含“主人UUID”字段
BELLDANDY_TOKEN_USAGE_STRICT_UUID=false
# IDENTITY.md 示例：**主人UUID**: 123e4567-e89b-12d3-a456-426614174000

# WebSocket Origin 白名单（逗号分隔，防 CSWSH 攻击）
# 作用：限制哪些网页/客户端可以连接到 Star Sanctuary Gateway
# 默认行为：若不设置，本地开发环境（HOST=127.0.0.1）自动允许 localhost/127.0.0.1
# 配置建议：
# - 纯本地使用（命令行）：不需要配置
# - 本地 Web 开发：BELLDANDY_ALLOWED_ORIGINS=http://localhost:5173
# - 公网部署/生产环境：BELLDANDY_ALLOWED_ORIGINS=https://console.belldandy.ai
# BELLDANDY_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# ========================================
# WebChat 附件限制
# ========================================
# 单个附件大小上限（字节，默认 10MB）
# BELLDANDY_ATTACHMENT_MAX_FILE_BYTES=10485760

# 单次消息所有附件总大小上限（字节，默认 30MB）
# BELLDANDY_ATTACHMENT_MAX_TOTAL_BYTES=31457280

# 单个文本附件注入到 prompt 的字符上限（默认 200000）
# 作用：限制单个 txt/md/json/js/ts/log 等文本附件被直接拼进上下文的长度
# BELLDANDY_ATTACHMENT_TEXT_CHAR_LIMIT=200000

# 单次消息所有文本附件 + 音频转录注入 prompt 的总字符预算（默认 200000）
# 作用：避免多个长文本附件或长转录内容线性放大 token 成本
# BELLDANDY_ATTACHMENT_TEXT_TOTAL_CHAR_LIMIT=200000

# 当用户已有文本输入时，单个音频转录作为“追加上下文”写入 prompt 的字符上限（默认 12000）
# 如果用户没有手动输入文本，音频转录仍可作为主 prompt，但仍受总字符预算约束
# BELLDANDY_AUDIO_TRANSCRIPT_APPEND_CHAR_LIMIT=12000

# ==================================================
# 模块 2 / 5：模型、Prompt 与会话编排
# ==================================================
# ========================================
# Agent 配置（REQUIRED）
# ========================================
# Agent 提供商: mock / openai（默认 mock）
BELLDANDY_AGENT_PROVIDER=openai

# OpenAI 兼容 API 配置
# 支持 OpenAI、Gemini、DeepSeek、Ollama 等兼容服务
BELLDANDY_OPENAI_BASE_URL=https://api.openai.com/v1
BELLDANDY_OPENAI_API_KEY=your_api_key_here
BELLDANDY_OPENAI_MODEL=gpt-4o

# Kimi K2.5 (Vision Support) 配置示例:
# BELLDANDY_OPENAI_BASE_URL=https://api.moonshot.cn/v1
# BELLDANDY_OPENAI_API_KEY=sk-xxxxxxxx
# BELLDANDY_OPENAI_MODEL=kimi-k2.5-preview

# 流式输出（默认 true）
# BELLDANDY_OPENAI_STREAM=true

# OpenAI 线路协议：chat_completions（默认）| responses
# 使用 aicodewith 的 gpt-5.3-codex 时通常需要设置为 responses
# BELLDANDY_OPENAI_WIRE_API=responses
# OpenAI-compatible 思考模式配置。
# 简写可直接写 enabled / disabled；高级用法可写 JSON，例如 {"type":"enabled"}
# 仅透传到 OpenAI-compatible 请求体，不会应用到 Anthropic 原生协议。
# BELLDANDY_OPENAI_THINKING=enabled
# OpenAI-compatible 推理强度（会透传为 reasoning_effort）
# 例如：high / max
# BELLDANDY_OPENAI_REASONING_EFFORT=high
# 仅在 responses + tools 模式下清洗工具 schema，移除 oneOf/$ref 等不兼容关键字
# 某些代理（如部分 aicodewith 路由）在 tools 模式下需要开启
# BELLDANDY_RESPONSES_SANITIZE_TOOL_SCHEMA=true
# OpenAI 默认重试次数（不含首次请求，默认 0）
# 仅对可重试错误生效（timeout/429/5xx/网络异常）
# BELLDANDY_OPENAI_MAX_RETRIES=1
# OpenAI 默认重试退避基线（毫秒，默认 300）
# 实际退避采用指数退避，最大约 5 秒
# BELLDANDY_OPENAI_RETRY_BACKOFF_MS=300
# OpenAI primary 专用代理 URL（可选）
# 用于网络受限场景；fallback 可在 models.json 里按模型单独覆盖 proxyUrl
# BELLDANDY_OPENAI_PROXY_URL=http://127.0.0.1:7890
# 启动时 primary 预热探测（失败会给 primary 加短期冷却，默认 true）
# BELLDANDY_PRIMARY_WARMUP_ENABLED=true
# 预热探测请求超时（毫秒，默认 8000）
# BELLDANDY_PRIMARY_WARMUP_TIMEOUT_MS=8000
# 预热失败后 primary 的冷却时间（毫秒，默认 60000）
# BELLDANDY_PRIMARY_WARMUP_COOLDOWN_MS=60000

# 额外的系统提示词（追加到 workspace prompt 之后）
# BELLDANDY_OPENAI_SYSTEM_PROMPT=

# System Prompt 注入配置
# 控制是否把 AGENTS.md / SOUL.md / MEMORY.md / Method & Skill 摘要索引 注入到模型 system prompt
# BELLDANDY_INJECT_AGENTS=true
# BELLDANDY_INJECT_SOUL=true
# BELLDANDY_INJECT_MEMORY=true
# BELLDANDY_INJECT_METHOD_SKILL_LIST=true
# 是否启用运行时 Prompt Focus Prelude（从当前工作区 AGENTS.md 中提取最相关片段作为额外前导）
# 默认 true；设为 false 可关闭该运行时增强
# BELLDANDY_PROMPT_FOCUS_ENABLED=true
# 是否启用 Prompt Focus 的语义召回（优先复用 embedding；不可用时自动回退 lexical）
# 默认 true
# BELLDANDY_PROMPT_FOCUS_SEMANTIC_ENABLED=true
# Prompt Focus 语义召回的最低相似度阈值
# 建议 0.25 ~ 0.45；值越高越保守
# BELLDANDY_PROMPT_FOCUS_SEMANTIC_MIN_SCORE=0.30
#
# System Prompt 最大字符数限制（超过则按优先级自动截断低优先级段落，0 或不设表示不限制）
# 适用于对输入长度有限制的 API 代理（如 aicodewith），建议值 20000~40000
# 换算参考：纯英文约 4 字符 ≈ 1 token，中英混合约 3~4 字符 ≈ 1 token
# 例：20000 字符 ≈ 5000~6600 tokens，40000 字符 ≈ 10000~13000 tokens
# BELLDANDY_MAX_SYSTEM_PROMPT_CHARS=0
#
# 传给模型的最近对话轮数（默认 50）
# 长期记忆已通过向量检索实现，此处只保留最近几轮维持对话连贯性
# 使用输入长度受限的 API 代理时建议设为 6~20
# BELLDANDY_MAX_HISTORY=50

# Prompt experiment: 禁用指定 section（按 section.id，逗号分隔）
# 例：BELLDANDY_PROMPT_EXPERIMENT_DISABLE_SECTIONS=methodology,context
# BELLDANDY_PROMPT_EXPERIMENT_DISABLE_SECTIONS=

# Prompt experiment: 覆盖指定 section 的 priority（id:priority，逗号分隔）
# 例：BELLDANDY_PROMPT_EXPERIMENT_SECTION_PRIORITY_OVERRIDES=methodology:5,extra:150
# BELLDANDY_PROMPT_EXPERIMENT_SECTION_PRIORITY_OVERRIDES=

# Prompt experiment: 禁用指定 tool contract（按 tool name，逗号分隔）
# 例：BELLDANDY_PROMPT_EXPERIMENT_DISABLE_TOOL_CONTRACTS=apply_patch,run_command
# BELLDANDY_PROMPT_EXPERIMENT_DISABLE_TOOL_CONTRACTS=

# Prompt Snapshot 持久化保留策略
# 内存中每个会话最多保留的最新 run 快照数（默认 48）
# 主要影响 prompt inspect / diagnostics 的运行时视图
# BELLDANDY_PROMPT_SNAPSHOT_MAX_RUNS=48
#
# 普通 conversation 在 diagnostics/prompt-snapshots 下每个会话最多保留的快照数（默认 20）
# BELLDANDY_PROMPT_SNAPSHOT_MAX_PERSISTED_RUNS=20

# 邮件线程 conversation 在 diagnostics/prompt-snapshots 下每个线程最多保留的快照数（默认 10）
# 只影响 channel=email:scope=per-account-thread:* 这类邮件线程，不影响普通聊天会话
# BELLDANDY_PROMPT_SNAPSHOT_EMAIL_THREAD_MAX_RUNS=10

# heartbeat 快照全局最多保留的份数（默认 5）
# 注意：heartbeat 会话通常每次都会生成新的 conversationId，因此这里是“全局保留”而不是“单会话保留”
# BELLDANDY_PROMPT_SNAPSHOT_HEARTBEAT_MAX_RUNS=5

# prompt snapshot 自动清理天数（默认 7，设为 0 表示关闭按天清理）
# BELLDANDY_PROMPT_SNAPSHOT_RETENTION_DAYS=7

# 单次模型调用超时（毫秒，默认 120000 即 2 分钟，最小 5000）
# BELLDANDY_AGENT_TIMEOUT_MS=120000

# API 协议：openai | anthropic（默认自动检测）
# 如果 BELLDANDY_OPENAI_BASE_URL 包含 anthropic.com，prompt caching 会自动启用
# 使用 Anthropic 原生协议可启用 Prompt Caching，显著降低 token 消耗和限流风险
# BELLDANDY_AGENT_PROTOCOL=anthropic

# ========================================
# 视频文件上传（Video File Upload）
# ========================================
# 当聊天代理（OPENAI_BASE_URL）不支持 Moonshot /files 端点时，
# 设置此项让视频上传走 Moonshot 直连 API。
# 仅设置 URL 时，API Key 回退到 BELLDANDY_OPENAI_API_KEY。
# BELLDANDY_VIDEO_FILE_API_URL=https://api.moonshot.cn/v1
# BELLDANDY_VIDEO_FILE_API_KEY=sk-xxx

# ========================================
# 模型容灾 (Model Failover)
# ========================================
# 备用模型配置文件路径（JSON 格式，默认 ~/.star_sanctuary/models.json）
# 配置后，主模型限流/故障时自动切换到备用模型，在不使用默认路径时才需要配置以下变量。
# 字段优先级（高→低）：
# 1) models.json 每个 fallback 的字段（wireApi/thinking/reasoningEffort/requestTimeoutMs/maxRetries/retryBackoffMs/proxyUrl）
# 2) 全局环境变量（BELLDANDY_OPENAI_*）
# 注意：primary 来自 .env，不在 models.json 的 fallbacks 中定义。
#
# 最小格式示例：
# {
#   "fallbacks": [
#     {
#       "id": "backup",
#       "baseUrl": "https://api.deepseek.com/v1",
#       "apiKey": "sk-xxx",
#       "model": "deepseek-chat",
#       "protocol": "openai",
#       "wireApi": "chat_completions",
#       "thinking": { "type": "enabled" },
#       "reasoningEffort": "high",
#       "requestTimeoutMs": 60000,
#       "maxRetries": 1,
#       "retryBackoffMs": 300,
#       "proxyUrl": "http://127.0.0.1:7890"
#     }
#   ]
# }
#
# “主稳 + gpt fallback” 示例（primary 走 .env 的稳定模型）：
# {
#   "fallbacks": [
#     {
#       "id": "gpt-5.3-codex",
#       "baseUrl": "https://api.aicodewith.com/chatgpt/v1",
#       "apiKey": "sk-xxx",
#       "model": "gpt-5.3-codex",
#       "protocol": "openai",
#       "wireApi": "responses",
#       "thinking": { "type": "enabled" },
#       "reasoningEffort": "max",
#       "requestTimeoutMs": 60000,
#       "maxRetries": 1,
#       "retryBackoffMs": 400
#     },
#     {
#       "id": "kimi-k2.5-relay",
#       "baseUrl": "https://aiping.cn/api/v1",
#       "apiKey": "sk-xxx",
#       "model": "kimi-k2.5",
#       "protocol": "openai",
#       "wireApi": "chat_completions",
#       "thinking": { "type": "enabled" },
#       "reasoningEffort": "high",
#       "requestTimeoutMs": 90000,
#       "maxRetries": 1,
#       "retryBackoffMs": 300
#     }
#   ]
# }
# 模型选择器中的 provider 排序偏好（逗号分隔，非必需）
# 只影响 UI / diagnostics 的排序展示，不改变实际 failover 顺序
# 示例：BELLDANDY_MODEL_PREFERRED_PROVIDERS=anthropic,moonshot,openrouter
# BELLDANDY_MODEL_PREFERRED_PROVIDERS=
# BELLDANDY_MODEL_CONFIG_FILE=~/.star_sanctuary/models.json

# ==================================================
# 模块 3 / 5：记忆、检索与经验沉淀
# ==================================================
# ========================================
# Embedding 配置（向量检索）
# ========================================
# 启用向量检索（需配置 Embedding 模型）
BELLDANDY_EMBEDDING_ENABLED=false

# Embedding 提供商选择: openai | local（默认 openai）
BELLDANDY_EMBEDDING_PROVIDER=openai

# OpenAI Embedding 模型
BELLDANDY_EMBEDDING_MODEL=text-embedding-3-small

# 本地 Embedding 模型名称（仅当 provider=local 时生效）
# 默认使用 "BAAI/bge-m3"，这是一款性能非常强大的多语言模型
# 模型会自动下载并保存到工作区目录下的 .star_sanctuary/models 文件夹中
# BELLDANDY_LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Embedding API 配置（留空则使用 BELLDANDY_OPENAI_* 配置）
# BELLDANDY_EMBEDDING_OPENAI_API_KEY=
# BELLDANDY_EMBEDDING_OPENAI_BASE_URL=

# Embedding 批处理大小（默认 2）
# 减小此值可避免 413 Payload Too Large 错误
BELLDANDY_EMBEDDING_BATCH_SIZE=2

# Context Injection（对话开始时自动注入最近记忆摘要）
# 启用后，每次对话开始时会自动从记忆库取最近 N 条记忆注入上下文，让 Agent "记住"近期事件
# 设为 false 可关闭（默认启用）
# BELLDANDY_CONTEXT_INJECTION=true

# 注入的记忆条数（默认 5）
# BELLDANDY_CONTEXT_INJECTION_LIMIT=5

# 是否允许把 session 类型短期会话记忆也注入上下文（默认 false）
# 建议保持关闭，避免把刚完成的执行步骤再次塞回上下文，引导 Agent 重复执行。
# BELLDANDY_CONTEXT_INJECTION_INCLUDE_SESSION=false

# 附带注入最近已完成任务的摘要条数（默认 3）
# 用于提醒 Agent 近期哪些任务已经做过，避免重复重启服务/重复跑命令。
# BELLDANDY_CONTEXT_INJECTION_TASK_LIMIT=3

# 自动注入时允许进入上下文的记忆分类（默认 preference,fact,decision,entity）
# 可选值：preference,fact,decision,entity,experience,other
# BELLDANDY_CONTEXT_INJECTION_ALLOWED_CATEGORIES=preference,fact,decision,entity

# Mind Profile Runtime（H1：统一心智入口的最小 runtime prelude）
# 启用后，在 before_agent_start 阶段按 gate 注入一小段稳定用户画像/长期记忆摘要
# 当前只在 main 会话尝试注入；goal / goal_node 会话默认跳过
# BELLDANDY_MIND_PROFILE_RUNTIME_ENABLED=true

# 最多注入的摘要行数（默认 4）
# BELLDANDY_MIND_PROFILE_RUNTIME_MAX_LINES=4

# 单行最大字符数（默认 120）
# BELLDANDY_MIND_PROFILE_RUNTIME_MAX_LINE_LENGTH=120

# 整段 runtime prelude 的总字符预算（默认 360）
# BELLDANDY_MIND_PROFILE_RUNTIME_MAX_CHARS=360

# 触发注入所需的最小稳定信号数（默认 2）
# 值越高越保守，越不容易注入
# BELLDANDY_MIND_PROFILE_RUNTIME_MIN_SIGNAL_COUNT=2

# Task 去重守卫：阻止最近已成功执行过的相同工具动作再次执行（默认 true）
# 可通过工具参数 retry=true / force=true / allowDuplicate=true 显式绕过。
# BELLDANDY_TASK_DEDUP_GUARD_ENABLED=true

# Task 去重守卫的时间窗口，单位分钟（默认 20）
# BELLDANDY_TASK_DEDUP_WINDOW_MINUTES=20

# Task 去重全局模式（默认 graded）
# 可选值：
# - off：关闭默认去重（仍可配合 BELLDANDY_TASK_DEDUP_POLICY 对个别工具单独开启）
# - graded：使用内置分级策略
# - strict：把内置 warn-only 工具也提升为 hard-block
# BELLDANDY_TASK_DEDUP_MODE=graded

# Task 去重策略覆盖（可选，逗号分隔）
# 格式：toolName:mode,toolName:mode
# mode 可选：hard-block | warn-only | off
# 默认内置策略：
# service_restart:hard-block,switch_facet:hard-block,method_create:hard-block,run_command:warn-only,file_write:warn-only,file_delete:warn-only
# 示例：
# BELLDANDY_TASK_DEDUP_POLICY=run_command:off,file_write:hard-block
# BELLDANDY_TASK_DEDUP_POLICY=service_restart:hard-block,run_command:warn-only,file_write:off
# BELLDANDY_TASK_DEDUP_POLICY=
#
# 常用组合示例：
# 1) 默认推荐：
# BELLDANDY_TASK_DEDUP_MODE=graded
# BELLDANDY_TASK_DEDUP_POLICY=
#
# 2) 保留重启/切面/方法创建强拦截，但允许重复跑命令：
# BELLDANDY_TASK_DEDUP_MODE=graded
# BELLDANDY_TASK_DEDUP_POLICY=run_command:off
#
# 3) 对文件落盘更保守，写入和删除都改为强拦截：
# BELLDANDY_TASK_DEDUP_MODE=graded
# BELLDANDY_TASK_DEDUP_POLICY=file_write:hard-block,file_delete:hard-block
#
# 4) 最保守模式：内置 warn-only 工具也统一升级为 hard-block
# BELLDANDY_TASK_DEDUP_MODE=strict
# BELLDANDY_TASK_DEDUP_POLICY=

# Auto-Recall（底层自动语义召回，默认关闭）
# 启用后，在 before_agent_start 阶段会基于用户原始输入自动执行 memory search，并静默注入相关历史记忆
# BELLDANDY_AUTO_RECALL_ENABLED=false

# Auto-Recall 每次最多注入的结果条数（默认 3）
# BELLDANDY_AUTO_RECALL_LIMIT=3

# Auto-Recall 最低相关性阈值（默认 0.3）
# BELLDANDY_AUTO_RECALL_MIN_SCORE=0.3

# 工具结果写回 transcript 的字符上限（默认 12000）
# 作用：当单次工具输出特别长时，只保留前后文摘要片段，避免下一轮模型把整段大输出再次吃进上下文
# BELLDANDY_TOOL_RESULT_TRANSCRIPT_CHAR_LIMIT=12000

# ========================================
# 记忆系统增强（Phase M-Next）
# ========================================
# L0 摘要层：索引后自动为长 chunk 生成 LLM 摘要，memory_search 默认返回摘要以节省 token
# BELLDANDY_MEMORY_SUMMARY_ENABLED=false

# 摘要生成用的模型（建议小模型以降低成本，默认继承主模型）
# BELLDANDY_MEMORY_SUMMARY_MODEL=gpt-4o-mini

# 摘要 API 地址和密钥（可选，默认继承主模型配置）
# BELLDANDY_MEMORY_SUMMARY_BASE_URL=
# BELLDANDY_MEMORY_SUMMARY_API_KEY=

# 会话记忆自动提取：会话结束后自动分析对话，提取用户偏好和经验教训写入每日记忆文件
# BELLDANDY_MEMORY_EVOLUTION_ENABLED=false

# Session Digest 刷新预算：限制窗口期内允许执行的 digest 刷新次数（默认不限制）
# 适用范围：conversation.digest.refresh 以及 message.send / message.error 后的自动 digest refresh
# BELLDANDY_MEMORY_SESSION_DIGEST_MAX_RUNS=

# Session Digest 刷新预算窗口（毫秒，默认 3600000 = 1 小时）
# 仅在设置了 BELLDANDY_MEMORY_SESSION_DIGEST_MAX_RUNS 时生效
# BELLDANDY_MEMORY_SESSION_DIGEST_WINDOW_MS=3600000

# Durable Extraction 后台调度预算：限制窗口期内允许进入后台 extraction 调度的次数（默认不限制）
# 适用范围：conversation.memory.extract 与 digest 更新后触发的 durable extraction 调度
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_MAX_RUNS=

# Durable Extraction 后台调度预算窗口（毫秒，默认 3600000 = 1 小时）
# 仅在设置了 BELLDANDY_MEMORY_DURABLE_EXTRACTION_MAX_RUNS 时生效
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_WINDOW_MS=3600000

# Durable Extraction 细化触发阈值：最少待处理消息数（默认 0 = 不额外限制）
# 当 pending message 数量低于此值时，runtime 会跳过本轮 extraction 调度
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_MIN_PENDING_MESSAGES=0

# Durable Extraction 细化触发阈值：距离上次成功提取后，至少新增多少条消息才再次触发（默认 0 = 不额外限制）
# 适合降低短对话或碎片更新导致的频繁重复提取
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_MIN_MESSAGE_DELTA=0

# Durable Extraction 成功冷却窗口（毫秒，默认 0 = 成功后不额外冷却）
# 设置后，成功完成一次 extraction 后，到冷却结束前不会再次进入调度
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_SUCCESS_COOLDOWN_MS=0

# Durable Extraction 失败退避基线（毫秒，默认沿用 runtime retryDelay，当前约 2000）
# 连续失败时会按指数退避增长，避免持续失败时高频重试
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_FAILURE_BACKOFF_MS=2000

# Durable Extraction 失败退避上限（毫秒，默认 60000）
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_FAILURE_BACKOFF_MAX_MS=60000

# 示例：把 Durable Extraction 调得更保守，减少短对话抖动与连续失败重试
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_MIN_PENDING_MESSAGES=6
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_MIN_MESSAGE_DELTA=4
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_SUCCESS_COOLDOWN_MS=300000
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_FAILURE_BACKOFF_MS=5000
# BELLDANDY_MEMORY_DURABLE_EXTRACTION_FAILURE_BACKOFF_MAX_MS=600000

# Team Shared Memory（当前仅前置条件工程化，默认关闭）
# 启用后会把 stateDir/team-memory 纳入 MemoryManager 索引源，并开放 doctor/readiness 诊断
# 当前只包含本地 path 规范、secret guard、最小索引挂接；不包含远端 sync / watcher / 服务端闭环
# BELLDANDY_TEAM_SHARED_MEMORY_ENABLED=false

# 示例：启用本地 team-memory 索引，用于共享记忆前置条件验证
# BELLDANDY_TEAM_SHARED_MEMORY_ENABLED=true
#
# Shared review claim 超时（毫秒，默认 3600000 = 1 小时）
# 超时后，共享记忆候选的 claim 可被其他 reviewer 重新接管
# BELLDANDY_SHARED_REVIEW_CLAIM_TIMEOUT_MS=3600000

# 触发提取的最少消息数（默认 4，过短的对话不提取）
# BELLDANDY_MEMORY_EVOLUTION_MIN_MESSAGES=4

# 提取用的模型（可选，默认继承主模型）
# BELLDANDY_MEMORY_EVOLUTION_MODEL=gpt-4o-mini

# 提取 API 地址和密钥（可选，默认继承主模型配置）
# BELLDANDY_MEMORY_EVOLUTION_BASE_URL=
# BELLDANDY_MEMORY_EVOLUTION_API_KEY=

# Task Memory：记录任务级执行结果（默认关闭）
# 开启后会按 conversation 记录 objective、toolCalls、memoryLinks、artifactPaths 等任务层数据，
# 供 Memory Viewer 的 Tasks 视图使用；不会改写现有 chunk 记忆结构。
# 仅想收集任务元数据时，开启 TASK_MEMORY 即可，不必同时开启 TASK_SUMMARY。
# BELLDANDY_TASK_MEMORY_ENABLED=false

# 在关闭 Memory 总开关时保留 Task 统计（默认关闭）
# 仅在 BELLDANDY_MEMORY_ENABLED=false 且 BELLDANDY_TASK_MEMORY_ENABLED=true 时生效。
# 开启后只保留 task 统计本身；不会恢复 context injection / auto recall / task summary /
# experience auto promotion / task dedup guard。
# BELLDANDY_TASK_STATS_WHEN_MEMORY_DISABLED=false

# Task Summary：为满足阈值的任务生成 LLM 总结（默认关闭）
# 开启后，仅对“耗时较长 / 工具调用较多 / token 消耗较高”的任务补一段总结。
# 建议先启用 TASK_MEMORY 观察样本，再决定是否启用 TASK_SUMMARY。
# BELLDANDY_TASK_SUMMARY_ENABLED=false

# Task Summary 使用的模型（可选，默认继承主模型）
# 建议优先使用稳定的文本聊天模型，例如 moonshot-v1-8k / moonshot-v1-32k
# 不建议使用 embedding 模型（如 text-embedding-v4）或 vision-preview 模型
# BELLDANDY_TASK_SUMMARY_MODEL=moonshot-v1-8k

# Task Summary API 地址和密钥（可选，默认继承主模型配置）
# BELLDANDY_TASK_SUMMARY_BASE_URL=
# BELLDANDY_TASK_SUMMARY_API_KEY=

# Task Summary 触发阈值（满足其一即可触发，总结前提仍需 TASK_MEMORY_ENABLED=true）
# 最小任务耗时（毫秒，默认 15000）
# BELLDANDY_TASK_SUMMARY_MIN_DURATION_MS=15000
# 最小工具调用次数（默认 2）
# BELLDANDY_TASK_SUMMARY_MIN_TOOL_CALLS=2
# 最小总 token 消耗（默认 2000）
# BELLDANDY_TASK_SUMMARY_MIN_TOKEN_TOTAL=2000

# 示例 1：只启用 Task Viewer 数据沉淀，不做 LLM 总结
# BELLDANDY_TASK_MEMORY_ENABLED=true
# BELLDANDY_TASK_SUMMARY_ENABLED=false

# 示例 1.1：关闭长期记忆注入/召回，但保留 Task 统计
# BELLDANDY_MEMORY_ENABLED=false
# BELLDANDY_TASK_MEMORY_ENABLED=true
# BELLDANDY_TASK_STATS_WHEN_MEMORY_DISABLED=true
# BELLDANDY_TASK_SUMMARY_ENABLED=false

# 示例 2：启用 Task Memory + 高价值任务总结
# BELLDANDY_TASK_MEMORY_ENABLED=true
# BELLDANDY_TASK_SUMMARY_ENABLED=true
# BELLDANDY_TASK_SUMMARY_MODEL=moonshot-v1-32k
# BELLDANDY_TASK_SUMMARY_MIN_DURATION_MS=30000
# BELLDANDY_TASK_SUMMARY_MIN_TOOL_CALLS=3
# BELLDANDY_TASK_SUMMARY_MIN_TOKEN_TOTAL=4000

# 第五阶段：Method / Skill 半自动沉淀（默认开启）
# 前提：需要先开启 TASK_MEMORY，否则不会记录 task，自然也不会生成候选。
# 当前自动生成只会写入 experience_candidates 候选层，不会自动发布到正式 methods/ 或用户 skills/。
# 当前自动生成走规则化提炼，不直接依赖 TASK_SUMMARY_MODEL。
# TASK_SUMMARY 只是在开启后补强 task 的 summary/reflection/outcome，从而间接提升候选质量。
BELLDANDY_EXPERIENCE_AUTO_PROMOTION_ENABLED=true

# 自动生成 method 候选（默认开启）
BELLDANDY_EXPERIENCE_AUTO_METHOD_ENABLED=true

# 自动生成 skill 候选草稿（默认开启）
BELLDANDY_EXPERIENCE_AUTO_SKILL_ENABLED=true

# Method / Skill 生成是否需要用户确认（默认 false）
# 影响 task detail 里的“生成 method candidate / 生成 skill candidate”等入口
# BELLDANDY_METHOD_GENERATION_CONFIRM_REQUIRED=false
# BELLDANDY_SKILL_GENERATION_CONFIRM_REQUIRED=false

# Method / Skill 发布是否需要用户确认（默认 false；如需更保守可手动改为 true）
# 影响 candidate panel 里的“接受并发布”等入口
# BELLDANDY_METHOD_PUBLISH_CONFIRM_REQUIRED=false
# BELLDANDY_SKILL_PUBLISH_CONFIRM_REQUIRED=false

# 经验能力合成参数
# 单次合成最多选取的“相似草稿”数量（不含种子草稿，默认 5）
# BELLDANDY_EXPERIENCE_SYNTHESIS_MAX_SIMILAR_SOURCES=5
# 单个来源草稿正文摘录的最大字符数（默认 1600）
# BELLDANDY_EXPERIENCE_SYNTHESIS_MAX_SOURCE_CONTENT_CHARS=1600
# 单次合成时所有来源草稿正文摘录的总字符预算（默认 10000）
# BELLDANDY_EXPERIENCE_SYNTHESIS_TOTAL_SOURCE_CONTENT_CHAR_BUDGET=10000
# 说明：
# - 实际单次提交给模型的来源上限 = 1 个种子草稿 + 最多 N 个相似草稿
# - create 时默认会勾选“合成成功后，将参与来源标记为已消化”
# - `清理旧稿` 是 WebChat 中的手动动作，不对应单独环境变量
# - 如果合成经常超时、输出被截断或模型不稳定，可优先降低：
#   1. BELLDANDY_EXPERIENCE_SYNTHESIS_MAX_SIMILAR_SOURCES
#   2. BELLDANDY_EXPERIENCE_SYNTHESIS_MAX_SOURCE_CONTENT_CHARS
#   3. BELLDANDY_EXPERIENCE_SYNTHESIS_TOTAL_SOURCE_CONTENT_CHAR_BUDGET
# - 如果你的模型在结构化输出上不稳定，优先选择 JSON 服从度更高的主模型

# 示例 3：只自动沉淀 method，关闭 skill 自动草稿
# BELLDANDY_TASK_MEMORY_ENABLED=true
# BELLDANDY_EXPERIENCE_AUTO_PROMOTION_ENABLED=true
# BELLDANDY_EXPERIENCE_AUTO_METHOD_ENABLED=true
# BELLDANDY_EXPERIENCE_AUTO_SKILL_ENABLED=false

# 源路径聚合检索：搜索时对高频命中的文件自动拉取上下文 chunk，提升长文档检索连贯性
# BELLDANDY_MEMORY_DEEP_RETRIEVAL=false

# Task-aware Embedding 前缀（用于 Jina/BGE 等支持 task 参数的模型）
# 查询时在文本前添加 queryPrefix，索引时添加 passagePrefix，可提升检索相关性 5-15%
# BGE 系列示例: BELLDANDY_EMBEDDING_QUERY_PREFIX="query: "  BELLDANDY_EMBEDDING_PASSAGE_PREFIX="passage: "
# Jina 系列示例: BELLDANDY_EMBEDDING_QUERY_PREFIX="retrieval.query: "  BELLDANDY_EMBEDDING_PASSAGE_PREFIX="retrieval.passage: "
# 不设置则不添加前缀（兼容 OpenAI text-embedding 等不需要前缀的模型）
# BELLDANDY_EMBEDDING_QUERY_PREFIX=
# BELLDANDY_EMBEDDING_PASSAGE_PREFIX=

# Reranker 配置
# 硬截断最低分数，低于此分数的检索结果直接丢弃（默认 0.15）
# BELLDANDY_RERANKER_MIN_SCORE=0.15
# 长度归一化锚点（字符数），防止长文本靠关键词密度霸榜（默认 500，0 表示不归一化）
# BELLDANDY_RERANKER_LENGTH_NORM_ANCHOR=500
#
# Memory Indexer watch 详细日志（默认 false）
# 调试 memory / team-memory / workspace watcher 时可开启；开启后日志量会明显增加
# BELLDANDY_MEMORY_INDEXER_VERBOSE_WATCH=true

# ==================================================
# 模块 4 / 5：工具、多媒体与执行控制
# ==================================================
# ========================================
# 功能开关
# ========================================
# 启用工具调用（ReAct 循环；联网、读写文件等,false/true）
BELLDANDY_TOOLS_ENABLED=true

# 启用 CLI / IDE 桥接工具族（默认关闭）
# 开启后会注册 bridge_target_list、bridge_run、bridge_session_*，
# 具体 target/action 仍需在 BELLDANDY_STATE_DIR/agent-bridge.json 中声明
BELLDANDY_AGENT_BRIDGE_ENABLED=false

# 仅在 responses + tools 模式下清洗工具 schema，移除 oneOf/$ref 等不兼容关键字
# 某些代理（如部分 aicodewith 路由）在 tools 模式下需要开启
BELLDANDY_RESPONSES_SANITIZE_TOOL_SCHEMA=true

# Agent 是否可控制已注册工具的全局 disabled 列表
# - disabled: 禁止 Agent 修改工具开关
# - confirm: Agent 发起后，需用户回复固定文本口令确认
# - auto: Agent 可直接修改全局工具开关
BELLDANDY_AGENT_TOOL_CONTROL_MODE=confirm

# 工具开关确认密码（仅在 BELLDANDY_AGENT_TOOL_CONTROL_MODE=confirm 时生效）
# - 留空：沿用“批准工具设置变更 <requestId>”确认口令
# - 已设置：用户改为输入这里配置的确认口令；系统不会回显该口令
BELLDANDY_AGENT_TOOL_CONTROL_CONFIRM_PASSWORD=your_password_here

# 工具分组加载（默认 all 加载全部，逗号分隔可选组）
# 可选组：browser（浏览器自动化）, multimedia（摄像头/图片生成/TTS）, methodology（方法论SOP）, system（日志/定时任务/重启/模组切换）
# core 组（file/fetch/memory/apply_patch）始终加载，无需指定
# 当前运行时默认采用“core tools + tool_search + deferred tools”策略：
# 非核心工具即使属于已启用分组，也会先以目录形式暴露，等 Agent 通过 tool_search 选择后再把完整 schema 加载进后续轮次上下文
# 使用中转代理时建议只加载需要的组以减少 token 消耗
# 示例：BELLDANDY_TOOL_GROUPS=core（只加载核心工具）
# 示例：BELLDANDY_TOOL_GROUPS=browser,system（加载核心+浏览器+系统工具）
# BELLDANDY_TOOL_GROUPS=all

# 最大输入 token 数限制（超过时自动裁剪历史消息，0 或不设表示不限制）
# 使用有输入长度限制的中转代理时建议设置，如 BELLDANDY_MAX_INPUT_TOKENS=20000
# 文本附件会按单文件 200000 字符截断后注入；当文本附件累计字符 >=12000/30000 时，
# 请求超时下限会自动提升到 120s/300s（普通文本请求不受影响）
# BELLDANDY_MAX_INPUT_TOKENS=0

# 单次模型调用最大输出 token 数（默认 4096）
# 建议调大到 8192 或更高，避免模型在生成长内容（如大型工具调用 JSON）时被截断
# 截断会导致工具参数残缺，引发 file_write "path 必须是非空字符串" 等错误
# BELLDANDY_MAX_OUTPUT_TOKENS=4096

# 工具循环轮次预算（阶段 5 / C3）
# 用于限制单次工具循环内最多允许多少轮模型调用，避免长时间 tool loop 静默烧 token
# 接近预算时运行时会向下一轮 prompt 注入 warning delta，超限后会先尝试强制 compaction 再阻断
# BELLDANDY_TOOL_LOOP_ITERATION_BUDGET=8

# 工具循环预算预警比例（默认由运行时提供）
# 例如 0.75 表示达到预算 75% 后就开始注入 warning delta
# BELLDANDY_TOOL_LOOP_WARNING_FRACTION=0.75

# 启用记忆系统
BELLDANDY_MEMORY_ENABLED=true

# 记忆数据库路径
# BELLDANDY_MEMORY_DB=~/.star_sanctuary/memory.db

# 启用 MCP 协议支持
BELLDANDY_MCP_ENABLED=false

# 启用浏览器自动化
BELLDANDY_BROWSER_RELAY_ENABLED=false

# 浏览器 Relay 端口
# BELLDANDY_RELAY_PORT=28892

# 浏览器工具域名白名单（逗号分隔）
# 仅当启用浏览器自动化时生效；配置后只允许访问这些域名及其子域名
# 适合把浏览器能力限制在文档站、代码托管站、业务后台等明确站点
# 示例：BELLDANDY_BROWSER_ALLOWED_DOMAINS=github.com,developer.mozilla.org,docs.example.com
# BELLDANDY_BROWSER_ALLOWED_DOMAINS=

# 浏览器工具域名黑名单（逗号分隔，优先级高于白名单）
# 适合显式禁止邮箱、网盘、支付、管理后台等高风险站点
# 示例：BELLDANDY_BROWSER_DENIED_DOMAINS=mail.google.com,drive.google.com,onedrive.live.com
# BELLDANDY_BROWSER_DENIED_DOMAINS=

# ========================================
# 本机摄像头 Helper（native_desktop）
# ========================================
# 作用：
# - 启用后，camera provider registry 会额外注册 native_desktop provider
# - 由 Gateway 启动一个本地 stdio helper，负责 Windows 摄像头诊断 / 枚举 / 拍照
# - 当前 helper 已实现 hello / diagnose / list_devices / capture_snapshot
#
# 启用前提：
# 1. 已执行 `corepack pnpm --filter @belldandy/skills build`
# 2. 本机可执行 `node`
# 3. Windows 上可执行 `powershell.exe`
# 4. 本机安装并可执行 `ffmpeg`
#
# 额外约束：
# - 如果 BELLDANDY_CAMERA_NATIVE_HELPER_COMMAND 使用 `node` / `node.exe`，
#   则 BELLDANDY_CAMERA_NATIVE_HELPER_ARGS_JSON 中必须包含 helper 入口脚本路径
# - 若 command / cwd 配置为路径形式，启动前会校验其是否存在
# - 若存在 `STAR_SANCTUARY_RUNTIME_DIR` / `BELLDANDY_RUNTIME_DIR`，repo 相对 helper entry
#   会优先按 cwd 解析，找不到时再回退到 runtimeDir（安装态 `current/`）解析
# - 推荐统一保留 `packages/belldandy-skills/dist/.../camera-native-desktop-helper.js`
#   这种 repo 相对 helper entry；源码仓库与安装态可共用同一份 args 配置
#
# 最小必需项：
# - BELLDANDY_CAMERA_NATIVE_HELPER_COMMAND
# - BELLDANDY_CAMERA_NATIVE_HELPER_ARGS_JSON
#
# 推荐生产/本机示例：启动已构建的 dist helper
# BELLDANDY_CAMERA_NATIVE_HELPER_COMMAND=node
# BELLDANDY_CAMERA_NATIVE_HELPER_ARGS_JSON=["packages/belldandy-skills/dist/builtin/multimedia/camera-native-desktop-helper.js"]
#
# 可选开发态示例：直接跑 TS 源码 helper（依赖 tsx）
# BELLDANDY_CAMERA_NATIVE_HELPER_COMMAND=node
# BELLDANDY_CAMERA_NATIVE_HELPER_ARGS_JSON=["--import","tsx","packages/belldandy-skills/src/builtin/multimedia/camera-native-desktop-helper.ts"]
#
# helper 子进程工作目录；源码仓库建议指向仓库根目录，安装态建议指向安装根目录
# 若包装器已导出 `STAR_SANCTUARY_RUNTIME_DIR` / `BELLDANDY_RUNTIME_DIR`，则 helper entry
# 会自动回退到 runtimeDir（通常是安装根下的 `current/`）
# BELLDANDY_CAMERA_NATIVE_HELPER_CWD=E:/project/star-sanctuary
#
# helper 启动握手超时（毫秒，默认 10000）
# BELLDANDY_CAMERA_NATIVE_HELPER_STARTUP_TIMEOUT_MS=10000
#
# helper 普通请求超时（毫秒，默认 15000）
# 拍照或设备探测偏慢的机器可适当调大
# BELLDANDY_CAMERA_NATIVE_HELPER_REQUEST_TIMEOUT_MS=15000

# helper 空闲自动回收时间（毫秒，默认 2000）
# 设为 0 表示禁用空闲自动回收；仅在明确需要常驻 helper 时再关闭
# BELLDANDY_CAMERA_NATIVE_HELPER_IDLE_SHUTDOWN_MS=2000
#
# 额外注入到 helper 子进程的环境变量（JSON object，可选）
# 适合把 helper 专用配置收口到一项里
# BELLDANDY_CAMERA_NATIVE_HELPER_ENV_JSON={"BELLDANDY_CAMERA_NATIVE_HELPER_FFMPEG_COMMAND":"C:/ffmpeg/bin/ffmpeg.exe"}
#
# helper 内部调用 PowerShell 的命令（默认 powershell.exe）
# BELLDANDY_CAMERA_NATIVE_HELPER_POWERSHELL_COMMAND=powershell.exe
#
# helper 内部调用 PowerShell 时附加的前置参数（JSON array，可选）
# 常规情况下保持为空；仅在需要包一层脚本/launcher 时再设置
# BELLDANDY_CAMERA_NATIVE_HELPER_POWERSHELL_ARGS_JSON=[]
#
# helper 内部调用 ffmpeg 的命令（默认 ffmpeg）
# 如 ffmpeg 未加入 PATH，建议直接填绝对路径
# BELLDANDY_CAMERA_NATIVE_HELPER_FFMPEG_COMMAND=C:/Program Files (x86)/ffmpeg/bin/ffmpeg.exe
#
# helper 内部调用 ffmpeg 时附加的前置参数（JSON array，可选）
# 常规情况下保持为空；仅在需要 wrapper/script 时再设置
# BELLDANDY_CAMERA_NATIVE_HELPER_FFMPEG_ARGS_JSON=[]
#
# 常见失败提示：
# - `command "...\" was not found on PATH`：检查 helper command 是否已安装或使用绝对路径
# - `Configured native_desktop helper cwd does not exist`：检查 BELLDANDY_CAMERA_NATIVE_HELPER_CWD
# - `Configured native_desktop helper entry does not exist`：检查 BELLDANDY_CAMERA_NATIVE_HELPER_ARGS_JSON 中的脚本路径；
#   若当前是安装态，还要确认 `STAR_SANCTUARY_RUNTIME_DIR` / `BELLDANDY_RUNTIME_DIR` 是否指向 `current/`
#
# 启用定时任务
BELLDANDY_CRON_ENABLED=false

# ==================================================
# 模块 5 / 5：自动化、渠道与运行治理
# ==================================================
# Assistant Mode 产品层主开关
# 当前主要用于统一配置语义与诊断视图；实际主动驱动仍由 heartbeat / cron 决定。
# WebChat 设置页保存时会同步收口 heartbeat / cron，避免出现长期双模式。
BELLDANDY_ASSISTANT_MODE_ENABLED=false

# Dream（梦境）自动整理
# - 手动入口仍是 WebChat / RPC 的 `dream.run`
# - auto heartbeat / auto cron 只提供“尝试检查”的机会
# - 是否真的执行 dream，仍取决于内部 signal gate / cooldown / backoff / lock
# - 当前 dream 只写 Agent 私有 dream 文件，不会自动改写 MEMORY.md
BELLDANDY_DREAM_AUTO_HEARTBEAT_ENABLED=false
BELLDANDY_DREAM_AUTO_CRON_ENABLED=false

# Dream 独立模型调用策略
# - Dream 默认应尽量短平快地产出结构化 JSON，总体不需要像主对话那样走长推理
# - 如果主模型当前已启用 BELLDANDY_OPENAI_THINKING=enabled，Dream 运行时会默认改成 thinking=disabled
# - 这样可避免主对话的长推理配置被直接带进 Dream，兼容上也更通用
# - 如需显式覆盖，可在这里单独配置；留空则交给运行时按模型兼容策略决定
# BELLDANDY_DREAM_OPENAI_THINKING=disabled
# 示例：BELLDANDY_DREAM_OPENAI_THINKING={"type":"enabled"}
# BELLDANDY_DREAM_OPENAI_REASONING_EFFORT=
# Dream 单次请求超时（毫秒），避免长思考或网络问题把 runtime 卡在 running
# BELLDANDY_DREAM_OPENAI_TIMEOUT_MS=120000
# Dream 首次 max_tokens；若出现 reasoning 吃满预算，运行时会自动放大后重试一次
# BELLDANDY_DREAM_OPENAI_MAX_TOKENS=1000

# Dream 私有镜像到 Obsidian
# - 开启后，会把每个 Agent 的私有 dream 结果镜像到本地 Obsidian vault
# - Obsidian 只做镜像，不会反向写回 SS 内部 shared memory
BELLDANDY_DREAM_OBSIDIAN_ENABLED=false
# 示例：BELLDANDY_DREAM_OBSIDIAN_VAULT_PATH=C:\Users\admin\Documents\Obsidian Vault
# BELLDANDY_DREAM_OBSIDIAN_VAULT_PATH=
# 示例：BELLDANDY_DREAM_OBSIDIAN_ROOT_DIR=Star Sanctuary
# BELLDANDY_DREAM_OBSIDIAN_ROOT_DIR=Star Sanctuary

# Obsidian Commons 公共租界
# - 用于把已经通过 SS 内部共享审批的 shared memory 导出到 Obsidian 公共区
# - 如果不单独设置 VAULT_PATH / ROOT_DIR，会自动回退复用 DREAM_OBSIDIAN_* 对应值
BELLDANDY_COMMONS_OBSIDIAN_ENABLED=false
# 示例：BELLDANDY_COMMONS_OBSIDIAN_VAULT_PATH=C:\Users\admin\Documents\Obsidian Vault
# BELLDANDY_COMMONS_OBSIDIAN_VAULT_PATH=
# 示例：BELLDANDY_COMMONS_OBSIDIAN_ROOT_DIR=Star Sanctuary
# BELLDANDY_COMMONS_OBSIDIAN_ROOT_DIR=Star Sanctuary

# 启用心跳检查
BELLDANDY_HEARTBEAT_ENABLED=false

# 心跳检查间隔（支持 30m, 1h, 300s 格式）
# BELLDANDY_HEARTBEAT_INTERVAL=30m

# 心跳活跃时间窗口（例如 08:00-23:00）
# BELLDANDY_HEARTBEAT_ACTIVE_HOURS=

# 外部渠道外发是否需要确认（assistant mode 推荐开启）
# 控制向飞书 / QQ / Community / Discord 外发文本时，是否必须先经过页面确认
BELLDANDY_EXTERNAL_OUTBOUND_REQUIRE_CONFIRMATION=true

# Assistant Mode 主动外发时的外部渠道优先顺序（逗号分隔）
# resident 通道始终保留；这里只控制外部渠道的尝试顺序
# 示例：BELLDANDY_ASSISTANT_EXTERNAL_DELIVERY_PREFERENCE=feishu,qq,community,discord
BELLDANDY_ASSISTANT_EXTERNAL_DELIVERY_PREFERENCE=feishu,qq,community,discord

# 邮件外发是否需要确认（默认沿用外部渠道确认语义）
# BELLDANDY_EMAIL_OUTBOUND_REQUIRE_CONFIRMATION=true
# BELLDANDY_EMAIL_DEFAULT_PROVIDER=smtp
# BELLDANDY_EMAIL_SMTP_ENABLED=false
# BELLDANDY_EMAIL_SMTP_ACCOUNT_ID=default
# BELLDANDY_EMAIL_SMTP_HOST=smtp.example.com
# BELLDANDY_EMAIL_SMTP_PORT=587
# BELLDANDY_EMAIL_SMTP_SECURE=false
# BELLDANDY_EMAIL_SMTP_USER=mailer@example.com
# BELLDANDY_EMAIL_SMTP_PASS=
# BELLDANDY_EMAIL_SMTP_FROM_ADDRESS=mailer@example.com
# BELLDANDY_EMAIL_SMTP_FROM_NAME=Belldandy
# ---- Email inbound (IMAP polling fallback) ----
# 最小可用组合：
# BELLDANDY_EMAIL_IMAP_ENABLED=true
# BELLDANDY_EMAIL_IMAP_HOST=imap.example.com
# BELLDANDY_EMAIL_IMAP_USER=mailer@example.com
# BELLDANDY_EMAIL_IMAP_PASS=
# 修改后可在 WebChat -> 系统检查 -> Config Source / Email Inbound Runtime 中确认是否生效
# BELLDANDY_EMAIL_INBOUND_AGENT_ID=default
# BELLDANDY_EMAIL_IMAP_ENABLED=false
# BELLDANDY_EMAIL_IMAP_ACCOUNT_ID=default
# BELLDANDY_EMAIL_IMAP_HOST=imap.example.com
# BELLDANDY_EMAIL_IMAP_PORT=993
# BELLDANDY_EMAIL_IMAP_SECURE=true
# BELLDANDY_EMAIL_IMAP_USER=mailer@example.com
# BELLDANDY_EMAIL_IMAP_PASS=
# BELLDANDY_EMAIL_IMAP_MAILBOX=INBOX
# BELLDANDY_EMAIL_IMAP_POLL_INTERVAL_MS=60000
# BELLDANDY_EMAIL_IMAP_CONNECT_TIMEOUT_MS=10000
# BELLDANDY_EMAIL_IMAP_SOCKET_TIMEOUT_MS=20000
# BELLDANDY_EMAIL_IMAP_BOOTSTRAP_MODE=latest
# BELLDANDY_EMAIL_IMAP_RECENT_WINDOW_LIMIT=50

# ------ Webhook API（外部系统触发）------
# Webhook 配置文件路径（默认 ~/.star_sanctuary/webhooks.json）
# 配置后可通过 HTTP POST 触发 Agent，适用于 CI/CD、监控告警、定时任务等场景
# BELLDANDY_WEBHOOK_CONFIG_PATH=~/.star_sanctuary/webhooks.json
# Webhook 幂等性时间窗口（毫秒，默认 600000 即 10 分钟）
# 通过 X-Idempotency-Key 请求头防止重复执行
# BELLDANDY_WEBHOOK_IDEMPOTENCY_WINDOW_MS=600000
# 使用示例：
# curl -X POST http://127.0.0.1:28889/api/webhook/ci-alert \
#   -H "Authorization: Bearer your-token" \
#   -H "Content-Type: application/json" \
#   -H "X-Idempotency-Key: unique-event-id" \
#   -d '{"text": "CI 构建失败"}'
# 详细文档：docs/webhook.md

# ========================================
# 数据持久化路径
# ========================================
# 状态目录（配置、会话、记忆数据库；同时是 file_read/file_write/file_delete 的工作区根目录）
# 通用场景可直接设置 BELLDANDY_STATE_DIR；当同一仓库要在 Windows / WSL 分别维护独立运行态时，
# 可改用下面两个平台专用变量：
BELLDANDY_STATE_DIR=~/.star_sanctuary
# BELLDANDY_STATE_DIR_WINDOWS=C:\Users\your-name\.star_sanctuary
# BELLDANDY_STATE_DIR_WSL=~/.star_sanctuary

# 工作区目录（文件工具访问范围，Docker 部署使用）
BELLDANDY_WORKSPACE_DIR=./workspace

# 额外允许 Agent 读写的根目录（逗号分隔，如其他盘符下的目录）
# 不设则仅限上面状态目录
# BELLDANDY_EXTRA_WORKSPACE_ROOTS=E:\tools,D:\projects

# WebChat 静态文件路径（通常无需修改）
# BELLDANDY_WEB_ROOT=apps/web/public

# WebChat 治理详情显示模式
# 作用：
# - 控制 `记忆查看 / 经验能力 / 长期任务` 这些治理审阅类页面右侧详情区的显示密度
# - `compact`：只显示重要级信息，适合日常查看与快速判断
# - `full`：显示完整信息，适合追溯、排障、深挖治理细节
# 默认值：
# - 不设置时会回退到 `compact`
# - 设置非法值时也会统一回退到 `compact`
# WebChat 设置入口：
# - 右上角 `⚙️ 设置` -> `系统` -> `Governance Detail Mode`
# 示例：
# BELLDANDY_WEB_GOVERNANCE_DETAIL_MODE=compact
# BELLDANDY_WEB_GOVERNANCE_DETAIL_MODE=full
BELLDANDY_WEB_GOVERNANCE_DETAIL_MODE=compact

# Commander / Goal Governance 默认配置
# 作用：
# - 控制长期任务 capability plan 的默认执行拓扑、治理模式和默认 commander
# - Node 级 capability plan 仍可在 Goal 详情页单独覆盖
# WebChat 设置入口：
# - 右上角 `⚙️ 设置` -> `系统` -> `Commander / Goal Governance`
# 示例：
# BELLDANDY_COMMANDER_MODE=auto
# BELLDANDY_COMMANDER_AGENT_ID=commander
# BELLDANDY_GOAL_EXECUTION_MODE=auto
# BELLDANDY_GOAL_GOVERNANCE_MODE=auto
# BELLDANDY_COMMANDER_AUTO_REWORK_ENABLED=false

# WebChat 经验草稿生成提示
# 作用：
# - 控制普通 `Method Draft / Skill Draft` 生成成功时，右下角是否弹出提示
# - `true`：弹提示
# - `false`：不弹提示
# 说明：
# - 这个开关只影响“普通生成”提示
# - `facet / faqi` 切换提示、合成草稿提示不受它影响
# - 默认值为 `true`
# 示例：
# BELLDANDY_WEB_EXPERIENCE_DRAFT_GENERATE_NOTICE_ENABLED=true
# BELLDANDY_WEB_EXPERIENCE_DRAFT_GENERATE_NOTICE_ENABLED=false
BELLDANDY_WEB_EXPERIENCE_DRAFT_GENERATE_NOTICE_ENABLED=true

# ========================================
# 日志配置
# ========================================
# 最低日志级别 (debug/info/warn/error)，可以通过设置 BELLDANDY_LOG_LEVEL=info 来过滤掉所有 debug 级别的浏览器日志。
BELLDANDY_LOG_LEVEL=info
# 是否输出到控制台 / 是否写入文件
BELLDANDY_LOG_CONSOLE=true
BELLDANDY_LOG_FILE=true

# 日志目录
BELLDANDY_LOG_DIR=~/.star_sanctuary/logs

# 单个日志文件最大大小（触发轮转）
BELLDANDY_LOG_MAX_SIZE=10MB

# 日志保留天数（自动清理）
BELLDANDY_LOG_RETENTION_DAYS=7

# ========================================
# 工具与安全配置
# ========================================
# 危险工具开关（run_command）
# BELLDANDY_DANGEROUS_TOOLS_ENABLED=false

# 工具策略配置文件（覆盖默认工具策略）
# BELLDANDY_TOOLS_POLICY_FILE=~/.star_sanctuary/tools-policy.json
# 示例文件：
# - config/tools-policy.strict.json：最保守档
# - config/tools-policy.balanced.json：平衡推荐档
# - config/tools-policy.open.json：受控开放档

# 会话历史工具可读取的会话类别（默认全开）
# 可选值：main,subtask,goal,heartbeat / all / none
BELLDANDY_CONVERSATION_ALLOWED_KINDS=all

# ========================================
# 对话压缩（Context Compaction）
# ========================================
# 是否启用上下文自动压缩（默认 true）
# 启用后，当历史消息 token 超过阈值时，自动将旧消息摘要化（三层渐进式压缩）
# BELLDANDY_COMPACTION_ENABLED=true

# 当历史消息的估算 token 数超过此阈值时，自动将旧消息摘要化以减少 token 消耗
# 默认 12000（约 12K tokens），设为 0 或不设表示不启用压缩
# 建议 Anthropic 模型设 8000，OpenAI 模型时设 20000
BELLDANDY_COMPACTION_THRESHOLD=20000

# 压缩时保留最近几条消息原文（默认 10）
BELLDANDY_COMPACTION_KEEP_RECENT=10

# ReAct 循环内压缩触发比例（默认 0.75，即上下文窗口使用 75% 时触发循环内压缩）
# 需配合 BELLDANDY_MAX_INPUT_TOKENS 使用
# BELLDANDY_COMPACTION_TRIGGER_FRACTION=0.75

# Rolling Summary 超过此 token 数时触发归档压缩（默认 2000）
# 归档压缩会将滚动摘要进一步浓缩为超简洁版本
# BELLDANDY_COMPACTION_ARCHIVAL_THRESHOLD=2000

# 预警阈值（默认取 compaction threshold 的约 70%，且至少 1024）
# 作用：进入预警区后，运行时会把“快接近压缩/阻断线”的状态暴露到观测与 doctor
# BELLDANDY_COMPACTION_WARNING_THRESHOLD=

# 阻断阈值（默认取 compaction threshold 的约 90%，且至少比 warning 高 1）
# 作用：在高风险超长上下文下触发更强保护，避免请求在明显不可恢复状态下继续硬冲
# BELLDANDY_COMPACTION_BLOCKING_THRESHOLD=

# 连续 compaction 失败熔断阈值（默认 3）
# 达到后会暂时熔断自动压缩，避免每轮都重复触发失败摘要请求
# BELLDANDY_COMPACTION_MAX_CONSECUTIVE_FAILURES=3

# Prompt-too-long 重试次数（默认 2）
# 当摘要请求自身因为输入过长失败时，允许 runtime 做有限次裁剪重试
# BELLDANDY_COMPACTION_MAX_PTL_RETRIES=2

# 已知主模型 context window 时，用该比例推导 compaction threshold（阶段 0 / A4）
# 例如主模型窗口 128K 且这里设 0.1，则推导阈值约为 12.8K；未知窗口时仍回退固定阈值
# BELLDANDY_COMPACTION_CONTEXT_WINDOW_FRACTION=0.1

# compaction 摘要链路的模型路由（阶段 5 / B2）
# 支持：
# - primary：走主模型
# - <fallback-name>：走 models.json 中同名 fallback
# - manual:<model>：直接指定摘要模型名
# 如同时设置 BELLDANDY_COMPACTION_BASE_URL / API_KEY / MODEL，会继续作为显式覆盖
# BELLDANDY_COMPACTION_MODEL_ROUTE=primary

# 是否启用 DeepSeek 专项自动路由策略（默认 true）
# 控制：
# - `deepseek:auto / deepseek:flash / deepseek:pro` 虚拟模型路由
# - compaction 辅助摘要在 DeepSeek 场景下优先固定到 flash
# 关闭后，真实模型 ID、显式 fallback、显式 compaction route / manual override 仍正常工作
# BELLDANDY_DEEPSEEK_ROUTE_POLICY_ENABLED=true

# 摘要专用模型（可选，不设则复用主模型）
# 建议使用便宜/快速的模型（如 gpt-4o-mini）以降低成本
# BELLDANDY_COMPACTION_MODEL=gpt-4o-mini

# 摘要专用 API 地址和密钥（可选，不设则复用主模型的 BASE_URL / API_KEY）
# 当摘要模型与主模型不在同一服务商时需要配置
# BELLDANDY_COMPACTION_BASE_URL=https://api.openai.com/v1
# BELLDANDY_COMPACTION_API_KEY=sk-xxx

# ========================================
# TTS（语音合成）配置
# ========================================
# 启用语音模式（服务端自动将 Agent 回复转为语音，默认 false）
# BELLDANDY_TTS_ENABLED=false

# TTS 提供商: dashscope | edge (free) | openai
BELLDANDY_TTS_PROVIDER=edge

# 统一 TTS 模型名（可选）
# - openai 默认 tts-1
# - dashscope 默认 qwen3-tts-flash
# - edge provider 会忽略该项
# BELLDANDY_TTS_MODEL=

# 语音 ID: DashScope: Cherry | Edge: zh-CN-XiaoxiaoNeural | OpenAI: alloy
BELLDANDY_TTS_VOICE=zh-CN-XiaoxiaoNeural

# OpenAI TTS 专用 endpoint（可选）
# 仅在 TTS Provider=OpenAI 时使用；留空时回退到全局 BELLDANDY_OPENAI_*，再回退旧的 OPENAI_*
# BELLDANDY_TTS_OPENAI_BASE_URL=https://api.openai.com/v1
# BELLDANDY_TTS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Aliyun DashScope TTS（可选）
# 获取 Key: https://help.aliyun.com/zh/model-studio/get-api-key
# 说明：这是 DashScope provider 自己的 Key，不要填到 BELLDANDY_TTS_OPENAI_API_KEY
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# 图片生成（独立图片工具）
# ========================================
# 独立图片工具开关（默认 true）
# BELLDANDY_IMAGE_ENABLED=true

# 图片生成提供商（当前仅支持 openai）
# BELLDANDY_IMAGE_PROVIDER=openai

# 图片生成专用 OpenAI API Key
# 注意：这里不回退 BELLDANDY_OPENAI_API_KEY / OPENAI_API_KEY
# BELLDANDY_IMAGE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 图片生成专用 Base URL（默认官方）
# BELLDANDY_IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1

# 图片生成模型（默认 gpt-image-2）
# BELLDANDY_IMAGE_MODEL=gpt-image-2

# 图片生成默认输出格式：png | jpeg | webp
# BELLDANDY_IMAGE_OUTPUT_FORMAT=png

# 图片生成超时（毫秒，填 0 表示不额外限时）
# BELLDANDY_IMAGE_TIMEOUT_MS=60000

# ========================================
# 图片 / 视频识别（独立多模态理解）
# ========================================
# 图片识别开关（默认 false）
# BELLDANDY_IMAGE_UNDERSTAND_ENABLED=false
# 收到图片附件时自动识别（默认 true）
# BELLDANDY_IMAGE_UNDERSTAND_AUTO_ON_ATTACHMENT=true
# 图片识别提供商（当前仅支持 openai）
# BELLDANDY_IMAGE_UNDERSTAND_PROVIDER=openai
# 图片识别专用 OpenAI API Key
# BELLDANDY_IMAGE_UNDERSTAND_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 图片识别专用 Base URL（默认官方）
# BELLDANDY_IMAGE_UNDERSTAND_OPENAI_BASE_URL=https://api.openai.com/v1
# 图片识别模型（默认 gpt-4.1-mini）
# BELLDANDY_IMAGE_UNDERSTAND_MODEL=gpt-4.1-mini
# 图片识别超时（毫秒）
# BELLDANDY_IMAGE_UNDERSTAND_TIMEOUT_MS=60000
# 图片识别默认提示词（留空使用内置提示）
# BELLDANDY_IMAGE_UNDERSTAND_PROMPT=
# 图片识别输入大小上限（MB）
# BELLDANDY_IMAGE_UNDERSTAND_MAX_INPUT_MB=20

# 视频识别开关（默认 false）
# BELLDANDY_VIDEO_UNDERSTAND_ENABLED=false
# 收到视频附件时自动识别（默认 true）
# BELLDANDY_VIDEO_UNDERSTAND_AUTO_ON_ATTACHMENT=true
# 视频识别提供商（当前仅支持 openai）
# BELLDANDY_VIDEO_UNDERSTAND_PROVIDER=openai
# 视频识别专用 OpenAI API Key
# BELLDANDY_VIDEO_UNDERSTAND_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 视频识别专用 Base URL（默认官方）
# BELLDANDY_VIDEO_UNDERSTAND_OPENAI_BASE_URL=https://api.openai.com/v1
# 视频识别模型（默认 kimi-k2.5）
# BELLDANDY_VIDEO_UNDERSTAND_MODEL=kimi-k2.5
# 视频识别超时（毫秒）
# BELLDANDY_VIDEO_UNDERSTAND_TIMEOUT_MS=120000
# 视频识别传输方式：auto | openai_files | inline_data_url
# - auto：按接口自动选择；DashScope compatible-mode 默认走 inline_data_url
# - openai_files：先上传 /files，再传 ms://fileId
# - inline_data_url：直接内联 data:video/...;base64,...
# 示例 1：阿里云 DashScope compatible-mode
#   BELLDANDY_VIDEO_UNDERSTAND_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   BELLDANDY_VIDEO_UNDERSTAND_TRANSPORT=auto
# 示例 2：Moonshot / 其他支持 /files + ms:// 的兼容服务
#   BELLDANDY_VIDEO_UNDERSTAND_OPENAI_BASE_URL=https://api.moonshot.cn/v1
#   BELLDANDY_VIDEO_UNDERSTAND_TRANSPORT=openai_files
# BELLDANDY_VIDEO_UNDERSTAND_TRANSPORT=auto
# 原生视频理解传给兼容接口的 fps（可选）
# - 适用于支持 video_url.fps 的兼容接口，例如 DashScope compatible-mode
# - 留空表示使用服务端默认值；DashScope 文档默认值为 2.0
# - 推荐范围 0.1 ~ 10；数值越大，模型看到的抽帧越密，成本通常也越高
# BELLDANDY_VIDEO_UNDERSTAND_FPS=
# 自动视频附件识别注入的时间线条数
# - 默认 5
# - 填 0 表示不额外限制，按识别模型实际返回为准
# BELLDANDY_VIDEO_UNDERSTAND_AUTO_ATTACHMENT_MAX_TIMELINE_ITEMS=5
# 自动视频附件识别注入的摘要字符上限
# - 默认 640
# - 填 0 表示不截断，按识别模型实际返回为准
# BELLDANDY_VIDEO_UNDERSTAND_AUTO_ATTACHMENT_SUMMARY_CHAR_LIMIT=640
# 视频识别默认提示词（留空使用内置提示）
# BELLDANDY_VIDEO_UNDERSTAND_PROMPT=
# 视频识别输入大小上限（MB）
# BELLDANDY_VIDEO_UNDERSTAND_MAX_INPUT_MB=64

# 对工具截图结果自动做图片识别（默认 true）
# BELLDANDY_BROWSER_SCREENSHOT_AUTO_UNDERSTAND=true
# 对摄像头截图结果自动做图片识别（默认 true）
# BELLDANDY_CAMERA_SNAP_AUTO_UNDERSTAND=true
# 对 screen_capture 工具截图结果自动做图片识别（默认 true）
# BELLDANDY_SCREEN_CAPTURE_AUTO_UNDERSTAND=true

# ========================================
# 渠道配置
# ========================================
# Channels 路由引擎（默认关闭，开启后可按规则做 mention gating / agent 路由）
# BELLDANDY_CHANNEL_ROUTER_ENABLED=false
# 路由配置文件（JSON）
# BELLDANDY_CHANNEL_ROUTER_CONFIG_PATH=~/.star_sanctuary/channels-routing.json
# 路由默认 Agent ID（当规则未指定 agentId 时使用）
# BELLDANDY_CHANNEL_ROUTER_DEFAULT_AGENT_ID=default

# 飞书渠道配置
# BELLDANDY_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# BELLDANDY_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书渠道绑定的 Agent Profile ID（可选，默认使用 default Agent）
# 需先在 ~/.star_sanctuary/agents.json 中定义对应 profile
# BELLDANDY_FEISHU_AGENT_ID=researcher

# QQ 渠道配置
# BELLDANDY_QQ_APP_ID=xxxxxxxx
# BELLDANDY_QQ_APP_SECRET=xxxxxxxx
# 说明：当前运行时代码未消费 BELLDANDY_QQ_APP_TOKEN，因此这里不再保留该示例项

# QQ 渠道绑定的 Agent Profile ID（可选，默认使用 default Agent）
# BELLDANDY_QQ_AGENT_ID=default

# 默认开启沙箱环境（true/false）
# BELLDANDY_QQ_SANDBOX=true
# 抓取 QQ 原始事件样例（联调用，默认 false）
# BELLDANDY_QQ_EVENT_SAMPLE_CAPTURE_ENABLED=false
# QQ 事件样例目录（不设则回退 stateDir/tmp/qq-event-samples）
# BELLDANDY_QQ_EVENT_SAMPLE_CAPTURE_DIR=~/.star_sanctuary/storage/qq-event-samples
# QQ 语音空结果兜底 provider 顺序（逗号分隔）
# 注意：这不是主 STT provider，而是默认 STT 成功返回但文本为空时的二次兜底顺序
# 留空时会按已配置 provider 自动推导，并排除当前主 provider
# 例如：BELLDANDY_QQ_STT_FALLBACK_PROVIDERS=groq,openai
# 如果主 STT 已经是 dashscope，再写 dashscope 通常没有额外收益
# BELLDANDY_QQ_STT_FALLBACK_PROVIDERS=

# ----------------------------------------
# Discord 渠道配置
# ----------------------------------------
# 申请流程：https://discord.com/developers/applications
# 1. 创建 Application → 进入 Bot 页面 → Reset Token 获取 Bot Token
# 2. 开启 Privileged Gateway Intents：MESSAGE CONTENT INTENT（必须）
# 3. OAuth2 → URL Generator → Scopes: bot → 勾选 Send Messages / Read Message History 等权限 → 邀请到服务器
# 启用 Discord 渠道
# BELLDANDY_DISCORD_ENABLED=false

# Bot Token（在 Discord Developer Portal → Bot 页面获取）
# BELLDANDY_DISCORD_BOT_TOKEN=your-discord-bot-token-here
#
# 默认外发频道 ID（可选）
# 仅在需要把主动消息默认投递到固定 Discord 频道时设置
# BELLDANDY_DISCORD_DEFAULT_CHANNEL_ID=

# ========================================
# 多 Agent 配置
# ========================================
# Agent 配置文件路径（JSON 格式，默认 ~/.star_sanctuary/agents.json）
# 配置多个 Agent 实例，每个可使用不同模型和工具白名单
# 格式参考:
# {
#   "agents": [
#     {
#       "id": "coder",
#       "displayName": "编程助手",
#       "model": "primary",
#       "toolWhitelist": ["file_read", "file_write", "run_command"]
#     },
#     {
#       "id": "researcher",
#       "displayName": "调研助手",
#       "model": "deepseek-chat",
#       "toolWhitelist": ["web_fetch", "web_search", "memory_search"]
#     }
#   ]
# }
# 其中 model 字段：
#   "primary" → 使用环境变量配置（BELLDANDY_OPENAI_*）
#   其他值 → 引用 models.json 中对应 id 的条目
# 不创建此文件时，系统只有一个 default Agent，行为与之前完全一致
# 说明：当前运行时代码固定从 stateDir 下的 agents.json 读取，
# 尚未消费 BELLDANDY_AGENT_CONFIG_FILE；此示例仅保留作未来兼容占位
# BELLDANDY_AGENT_CONFIG_FILE=~/.star_sanctuary/agents.json

# 子 Agent 最大并发数（默认 3，超出的任务自动排队）
# BELLDANDY_SUB_AGENT_MAX_CONCURRENT=3

# 排队队列最大长度（默认 10，队列满时拒绝新任务）
# BELLDANDY_SUB_AGENT_MAX_QUEUE_SIZE=10

# 子 Agent 运行超时（毫秒，默认 120000 即 2 分钟）
# BELLDANDY_SUB_AGENT_TIMEOUT_MS=120000

# 子 Agent 嵌套委托最大深度（默认 2，防止无限递归）
# BELLDANDY_SUB_AGENT_MAX_DEPTH=2

# ========================================
# 语音识别 (STT) 配置
# ========================================
# Provider: openai | groq | dashscope（默认 openai）
# BELLDANDY_STT_PROVIDER=openai

# 统一 STT 模型名（可选）
# - openai 默认 whisper-1
# - groq 默认 whisper-large-v3-turbo
# - dashscope 默认 paraformer-v2
# BELLDANDY_STT_MODEL=

# 语言提示（默认 zh）
# BELLDANDY_STT_LANGUAGE=zh

# OpenAI STT 专用配置（可选，优先于 OPENAI_API_KEY / OPENAI_BASE_URL）
# 当聊天主模型走 DeepSeek / 代理，但语音转写想单独走 OpenAI 官方时可使用
# BELLDANDY_STT_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BELLDANDY_STT_OPENAI_BASE_URL=https://api.openai.com/v1

# Aliyun DashScope 语音识别的 Key
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq STT（如果不使用 OpenAI）
# BELLDANDY_STT_GROQ_API_KEY=gsk_xxx
# BELLDANDY_STT_GROQ_BASE_URL=https://api.groq.com/openai/v1

# ========================================
# 身份上下文系统配置（可选）
# ========================================
# 智能注入阈值：房间成员数 ≤ 此值时，在 System Prompt 中注入完整成员列表
# 房间成员数 > 此值时，仅注入统计信息，Agent 需调用工具查询详细信息
# 默认值：10（推荐值，平衡体验与 token 消耗）
# 调优建议：
# - 设为 5：更激进的 token 节省，但小型房间也需要调用工具
# - 设为 15：更好的用户体验，但中型房间 token 消耗增加
# BELLDANDY_ROOM_INJECT_THRESHOLD=10

# 房间成员列表缓存有效期（毫秒）
# 默认值：300000（5分钟）
# 说明：在同一会话中多次查询成员列表时，使用缓存可大幅节省 token
# 调优建议：
# - 成员变动频繁的场景：设为 60000（1分钟）
# - 成员变动不频繁的场景：设为 600000（10分钟）
# BELLDANDY_ROOM_MEMBERS_CACHE_TTL=300000

# ========================================
# FACET 模组切换配置
# ========================================
# FACET 切换锚点行（switch_facet 工具在 SOUL.md 中查找此字符串作为分界点）
# 锚点行及之前的内容保留，之后的内容会被替换为目标 facet 文件内容
# 注意！如果在 SOUL.md 中有多个相同的锚点行内容，会使用检索到的第一个（最上边）的锚点行
# 默认值：## **警告** FACET 模组 内容切换时，必须在这一行之后执行，不可覆盖替换这一行之前的内容。
# 示例：BELLDANDY_FACET_ANCHOR=<!-- FACET_ANCHOR -->
# BELLDANDY_FACET_ANCHOR=

# ========================================
# 其他配置
# ========================================
# 自动打开浏览器（启动时）
# AUTO_OPEN_BROWSER=true

# Setup 向导 Token（自动打开浏览器的魔法链接）
# SETUP_TOKEN=

# ========================================
# Tailscale 远程访问（可选）
# ========================================
# 从 https://login.tailscale.com/admin/settings/keys 获取 Auth Key
# 使用方法: docker-compose --profile tailscale up -d
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxx
# TAILSCALE_EXTRA_ARGS=--ssh  # 启用 SSH 访问（可选）




