# Auto detect text files and perform LF normalization
* text=auto

# Nix flake.lock should use LF
flake.lock text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Keep manifest-bound benchmark truth bytes stable across platforms
benchmarks/coding-agent/v3/real-web-ui-regression-truth-set.json text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
